            })


        filter_conditions['filter_groups'] = filter_groups

        current_table_id = app_page.get('table_id')
        dtable_server_url = get_inner_dtable_server_url()

        import dtable_events

        try:
            base = DTableServerAPI(username, dtable_uuid, dtable_server_url)
            metadata = base.get_metadata()
            linked_table_name = get_linked_table_name(metadata, current_table_id, link_column_key)
            if not linked_table_name:
                return api_error(status.HTTP_404_NOT_FOUND, 'linked table not found')
            link_table_columns = base.list_columns(linked_table_name)

            sql = dtable_events.filter2sql(
                linked_table_name,
                link_table_columns,
                filter_conditions,
                by_group=True
            )

            dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            rows = dtable_db_api.query(sql)['results']

            return Response({"linked_table_rows": rows})

        except dtable_events.SQLGeneratorOptionInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, app_page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        except dtable_events.DateTimeQueryInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, app_page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        except Exception as e:
            logger.exception('query dtable-db dtable: %s error: %s', dtable_uuid, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')


class DTableUniversalAppsLinkedRecordView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle, )

    def post(self, request, app_uuid):
        """
            insert linked row
        """

        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        linked_row_data = request.data.get('linked_row_data', None)
        if linked_row_data is None:
            error_msg = 'linked_row_data invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_row_id = request.data.get('table_row_id', None)
        if table_row_id is None:
            error_msg = 'table_row_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        other_table_id = request.data.get('other_table_id', None)
        if not other_table_id:
            error_msg = 'other_table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        link_id = request.data.get('link_id', None)
        if not link_id:
            error_msg = 'link_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_modify(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        other_table = next(filter(lambda x: x.get('_id') == other_table_id, tables), None)
        if not table or not other_table:
            error_msg = 'table %s or table %s not found.' % (table_id, other_table_id)
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        other_table_name = other_table.get('name', '')

        # migrate image files
        error, other_table_row_data_dict = _parse_row_data(dtable, metadata, other_table_name, linked_row_data)
        if error:
            return error

        dtable_server_url = get_inner_dtable_server_url()
        dtable_server_api = DTableServerAPI(username, str(dtable.uuid), dtable_server_url)
        try:
            other_table_row_data_dict = dtable_server_api.append_row(other_table_name, other_table_row_data_dict, apply_default=True)
        except requests.Timeout as e:
            logger.error('POST dtable: %s linked row data: %s timeout error: %s', dtable_uuid, other_table_row_data_dict, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('POST dtable: %s linked row data: %s error: %s', dtable_uuid, other_table_row_data_dict, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        other_table_row_id = other_table_row_data_dict.get('_id', None)
        if not other_table_row_id:
            error_msg = 'other_table_row_id Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        # add link
        data = {
            'link_id': link_id,
            'table_id': table_id,
            'other_table_id': other_table_id,
            'other_rows_ids_map': {
                table_row_id: [other_table_row_id],
            }
        }
        dtable_db_api = DTableDBAPI(username,str(dtable.uuid), INNER_DTABLE_DB_URL)
        try:
            dtable_db_api.batch_append_links(data)
        except requests.Timeout as e:
            logger.error('query dtable-db links dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('query dtable-db links dtable: %s data: %s error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response(other_table_row_data_dict, status=status.HTTP_201_CREATED)


class DTableUniversalAppsLinkedRecordsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle, )

    def post(self, request, app_uuid):
        """
            get linked records detail
        """

        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id = request.data.get('row_id', None)
        if not row_id:
            error_msg = 'row_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        start = request.data.get('start', 0)
        limit = request.data.get('limit', 100)
        try:
            start = int(start)
            limit = int(limit)
        except ValueError:
            start = 0
            limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)



        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if page.get('table_id') != table_id:
            error_msg = 'table %s is not belong to current page %s' % (table_id, page_id)
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        table_columns = table.get('columns', [])

        table_link_columns = [col for col in table_columns if col['type'] == 'link']

        column_key_record_map = {}
        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        for link_column in table_link_columns:
            data = {
                'table_id': table_id,
                'link_column': link_column.get('key', ''),
                'rows': [
                    {
                        "row_id": row_id,
                        "offset": start,
                        "limit": limit,
                    }
                ]
            }
            try:
                link_records = dtable_db_api.query_linked_records(data).get(row_id) or []
                link_record_ids = [row['row_id'] for row in link_records]
            except requests.Timeout as e:
                logger.error('query dtable-db dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
                link_record_ids = []
            except Exception as e:
                logger.exception('query dtable-db dtable: %s data: %s error: %s', dtable_uuid, data, e)
                link_record_ids = []
            if not link_record_ids:
                column_key_record_map[link_column['key']] = []
            else:
                link_record = []
                link_column_data = link_column.get('data', {})
                config_table_id = link_column_data.get('table_id', '')
                config_other_table_id = link_column_data.get('other_table_id', '')
                linked_table_id = config_other_table_id if config_table_id == table_id else config_table_id

                linked_table = next(filter(lambda x: x.get('_id') == linked_table_id, tables), None)
                if linked_table:
                    linked_table_table = linked_table.get('name', '')
                    link_record_ids_str = ','.join(map(lambda row_id: f"'{row_id}'", link_record_ids))
                    sql = "SELECT * FROM %s WHERE `_id` IN (%s) LIMIT %s" % ('`' + linked_table_table + '`', link_record_ids_str, len(link_record_ids))
                    try:
                        link_record = dtable_db_api.query(sql)['results']
                    except requests.Timeout as e:
                        logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
                        link_record = []
                    except Exception as e:
                        logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
                        link_record = []

                column_key_record_map[link_column['key']] = link_record

        return Response({'link_records': column_key_record_map})


class DTableUniversalAppsColumnLinkedRecordsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid):
        """
            get linked records detail by one column
        """

        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id = request.data.get('row_id', None)
        if not row_id:
            error_msg = 'row_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        column_key = request.data.get('column_key', None)
        if not column_key:
            error_msg = 'column_key invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        start = request.data.get('start', 0)
        limit = request.data.get('limit', 100)
        try:
            start = int(start)
            limit = int(limit)
        except ValueError:
            start = 0
            limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if page.get('table_id') != table_id:
            error_msg = 'table %s is not belong to current page %s' % (table_id, page_id)
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        table_columns = table.get('columns', [])
        link_column = None
        for col in table_columns:
            if col['key'] == column_key:
                link_column = col

        link_record = []
        data = {
            'table_id': table_id,
            'link_column': link_column.get('key', ''),
            'rows': [
                {
                    "row_id": row_id,
                    "offset": start,
                    "limit": limit,
                }
            ]
        }
        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            link_records = dtable_db_api.query_linked_records(data).get(row_id) or []
            link_record_ids = [row['row_id'] for row in link_records]
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
            link_record_ids = []
        except Exception as e:
            logger.exception('query dtable-db dtable: %s data: %s error: %s', dtable_uuid, data, e)
            link_record_ids = []
        if link_record_ids:
            link_column_data = link_column.get('data', {})
            config_table_id = link_column_data.get('table_id', '')
            config_other_table_id = link_column_data.get('other_table_id', '')
            linked_table_id = config_other_table_id if config_table_id == table_id else config_table_id

            linked_table = next(filter(lambda x: x.get('_id') == linked_table_id, tables), None)
            if linked_table:
                linked_table_table = linked_table.get('name', '')
                sql = "SELECT * FROM %s WHERE `_id` IN (%s) LIMIT %s" % (
                '`' + linked_table_table + '`', ', '.join(map(lambda row_id: f"'{row_id}'", link_record_ids)), len(link_record_ids))
                try:
                    link_record = dtable_db_api.query(sql)['results']
                except requests.Timeout as e:
                    logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
                    link_record = []
                except Exception as e:
                    logger.exception('query dtable-db dtable: %s sql: %s linked_table_table: %s error: %s', dtable_uuid, sql, linked_table_table, e)
                    link_record = []

        return Response({'link_records': link_record})


class DTableUniversalAppsLinksView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle, )

    def post(self, request, app_uuid):
        """
            add link
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_row_id = request.data.get('table_row_id', None)
        if table_row_id is None:
            error_msg = 'table_row_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        other_table_id = request.data.get('other_table_id', None)
        if not other_table_id:
            error_msg = 'other_table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        other_table_row_id = request.data.get('other_table_row_id')
        if not other_table_row_id:
            error_msg = 'other_table_row_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        link_id = request.data.get('link_id', None)
        if not link_id:
            error_msg = 'link_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not _can_modify_link_column(page):
            error_msg = 'page %s not a table or kanban or gallery' % page_id
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if page.get('table_id') != table_id:
            error_msg = 'page %s table %s invalid' % (page_id, table_id)
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if not app_page_can_modify(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        other_table = next(filter(lambda x: x.get('_id') == other_table_id, tables), None)
        if not table or not other_table:
            error_msg = 'table %s or table %s not found.' % (table_id, other_table_id)
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # add link
        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        data = {
            'link_id': link_id,
            'table_id': table_id,
            'other_table_id': other_table_id,
            'other_rows_ids_map': {
                table_row_id: [other_table_row_id],
            }
        }
        try:
            dtable_db_api.batch_append_links(data)
        except ConnectionError as e:
            if len(e.args) == 2:
                status_code = e.args[0]
                if 400 <= status_code < 500:
                    logger.warning('append links dtable: %s data: %s error: %s', dtable_uuid, data, e)
                    return api_error(status_code, 'Bad request')
            logger.error('append links dtable: %s data: %s error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except requests.Timeout as e:
            logger.error('append links dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        except Exception as e:
            logger.exception('append links dtable: %s data: %s error: %s', dtable_uuid, data, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response({'success': True})

