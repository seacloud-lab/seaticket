        dtable_server_url = get_inner_dtable_server_url()
        try:
            base = DTableServerAPI(username, dtable_uuid, dtable_server_url)
            base_db = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            res = base.batch_append_rows(table_name, rows_data, return_rows=True, apply_default=True)
            if link_infos:
                for link_info in link_infos:
                    try:
                        base_db.batch_append_links(link_info)
                    except ConnectionError as e:
                        if len(e.args) == 2:
                            status_code = e.args[0]
                            if 400 <= status_code < 500:
                                logger.warning('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
                            else:
                                logger.error('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
                        else:
                            logger.error('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
        except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response(res, status=status.HTTP_201_CREATED)

class DTableUniversalAppsRowsBatchRecoverView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)


    def post(self, request, app_uuid):
        """ batch append rows
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        rows_data = request.data.get('rows_data', [])
        if not rows_data:
            rows_data = []

        rows_data_archived = []
        rows_data_unarchived = []

        for row_data in rows_data:
            is_archived_str = row_data.get('_archived', None)
            if not is_archived_str:
                is_archived = None
            else:
                is_archived = to_python_boolean(is_archived_str)

            if is_archived:
                rows_data_archived.append(row_data)
            else:
                rows_data_unarchived.append(row_data)


        link_infos = request.data.get('link_infos', [])

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_add(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            table_id = page.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')

        dtable_server_url = get_inner_dtable_server_url()
        try:
            base = DTableServerAPI(username, dtable_uuid, dtable_server_url)
            base_db = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            if rows_data_archived:
                base_db.batch_append_rows(table_name, rows_data_archived)
            if rows_data_unarchived:
                base.batch_append_rows(table_name, rows_data_unarchived)
            if link_infos:
                for link_info in link_infos:
                    try:
                        base_db.batch_append_links(link_info)
                    except ConnectionError as e:
                        if len(e.args) == 2:
                            status_code = e.args[0]
                            if 400 <= status_code < 500:
                                logger.warning('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
                            else:
                                logger.error('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
                        else:
                            logger.error('append links dtable: %s data: %s error: %s', dtable_uuid, link_info, e)
        except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response({'success': True}, status=status.HTTP_201_CREATED)


class DTableUniversalAppRowsRetrievalView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid):
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id_list = request.data.get('row_id_list', [])
        if not row_id_list or not isinstance(row_id_list, list):
            return api_error(status.HTTP_400_BAD_REQUEST, 'row_id_list invalid')
        row_id_list = row_id_list[:100]

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = None
        for tmp_page in pages:
            if tmp_page['id'] == page_id:
                page = tmp_page
                break
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        if page['type'] not in ['table', 'calendar', 'single_record_page', 'gallery']:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')

        table_id = request.data.get('table_id', None)
        if not table_id:
            table_id = page.get('table_id')

        # table
        error, table = get_table_by_id(dtable_uuid, table_id)
        if error:
            return error
        table_name = table.get('name')
        columns = table.get('columns')
        table_column_keys = [col.get('key') for col in columns]
        shown_column_keys = page.get('shown_column_keys', [])
        shown_title_column_key = page.get('shown_title_column_key')
        shown_image_column_key = page.get('shown_image_column_key')
        if shown_title_column_key and shown_title_column_key not in shown_column_keys:
            shown_column_keys.append(shown_title_column_key)
        if shown_image_column_key and shown_image_column_key not in shown_column_keys:
            shown_column_keys.append(shown_image_column_key)

        if not shown_column_keys:
            error_msg = 'shown_column_keys is empty.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        shown_column_names = ['`' + column.get('name', '') + '`'
            for column in columns if column.get('key') in shown_column_keys]
        shown_column_names.append('`_id`')
        shown_column_names.append('`_archived`')
        shown_column_names.append('`_locked`')

        if page['type'] == 'single_record_page':
            filters = page.get('pre_filters', [])
            filter_conjunction = page.get('pre_filter_conjunction', 'And')
        else:
            filters = page.get('filters', [])
            filter_conjunction = page.get('filter_conjunction', 'And')

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''
        user_department_ids_map = get_departments_map_by_username(username)
        current_user_department_ids = user_department_ids_map['current_user_department_ids']
        current_user_department_and_sub_ids = user_department_ids_map['current_user_department_and_sub_ids']

        filter_conditions = {}

        if filters:
            for item in filters:
                column_key = item.get('column_key')
                filter_term = item.get('filter_term')
                filter_predicate = item.get('filter_predicate')
                if column_key not in table_column_keys:
                    error_msg = 'some columns in the pre-filter has been deleted.'
                    return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
                if filter_predicate == 'include_me':
                    item['filter_term'].append(username)
                if filter_predicate == 'is_current_user_ID':
                    item['filter_term'] = id_in_org
                if filter_term == 'current_user_department':
                    item['filter_term'] = current_user_department_ids
                if filter_term == 'current_user_department_and_sub':
                    item['filter_term'] = current_user_department_and_sub_ids
                if isinstance(filter_term, list):
                    if 'current_user_department' in filter_term or 'current_user_department_and_sub' in filter_term:
                        for i in range(len(filter_term)):
                            if filter_term[i] == 'current_user_department':
                                filter_term[i] = current_user_department_ids
                            elif filter_term[i] == 'current_user_department_and_sub':
                                filter_term[i] = current_user_department_and_sub_ids
                        flat_result = [item for sublist in filter_term for item in (sublist if isinstance(sublist, list) else [sublist])]
                        item['filter_term'] = list(set(flat_result))
            filter_conditions['filters'] = filters
            filter_conditions['filter_conjunction'] = filter_conjunction

        import dtable_events

        try:
            sql = dtable_events.filter2sql(
                table_name, columns, filter_conditions, by_group=False)
        except dtable_events.SQLGeneratorOptionInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        except dtable_events.DateTimeQueryInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        except Exception as e:
            logger.exception('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        sql = sql[:sql.rfind('LIMIT')]
        if 'WHERE' in sql:
            sql = '%(base_sql)s WHERE (%(where_sql)s) AND `_id` IN (%(row_ids)s)' % {
                'base_sql': sql[:sql.find('WHERE')],
                'where_sql': sql[sql.find('WHERE')+len('WHERE')+1:],
                'row_ids': ', '.join(map(lambda x: f"'{x}'", row_id_list))
            }
        else:
            sql = '%(base_sql)s WHERE `_id` IN (%(row_ids)s)' % {
                'base_sql': sql,
                'row_ids': ', '.join(map(lambda x: f"'{x}'", row_id_list))
            }

        sql = sql.replace('*', ', '.join(shown_column_names), 1)
        sql += ' LIMIT 0, %s' % len(row_id_list)
        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            resp_json = dtable_db_api.query(sql)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response(resp_json, status=status.HTTP_200_OK)


def check_via_button_request(request, app_uuid, action_type, use_plugin_metadata=False):
    """
    check some via-button requests
    return (some asset or None, api_error or None)
    """
    # arguments check
    page_id = request.data.get('page_id')
    if not page_id:
        error_msg = 'page_id invalid'
        return None, api_error(status.HTTP_400_BAD_REQUEST, error_msg)
    button_column_key = request.data.get('button_column_key')
    if not button_column_key:
        return None, api_error(status.HTTP_400_BAD_REQUEST, 'button_column_key invalid')
    action_id = request.data.get('action_id')
    if not action_id and action_type != 'lock_row':
        return None, api_error(status.HTTP_400_BAD_REQUEST, 'action_id invalid')
    row_id = request.data.get('row_id')
    if not row_id:
        return None, api_error(status.HTTP_400_BAD_REQUEST, 'row_id invalid')

    # permission and resource check
    auth = request.META.get('HTTP_AUTHORIZATION', '').split()
    is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
    if len(auth) != 2 or not is_valid:
        error_msg = 'Permission denied.'
        return None, api_error(status.HTTP_403_FORBIDDEN, error_msg)

    username = payload.get('username') or ''

    universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
    if not universal_app:
        error_msg = 'app %s not found.' % app_uuid
        return None, api_error(status.HTTP_404_NOT_FOUND, error_msg)

    if universal_app.inactive:
        error_msg = _('This app is not available')
        return None, api_error(status.HTTP_400_BAD_REQUEST, error_msg)

    dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)

    dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid, include_deleted=False)
    if not dtable:
        error_msg = 'Base %s not found' % dtable_uuid
        return None, api_error(status.HTTP_404_NOT_FOUND, error_msg)

    app_config = json.loads(universal_app.app_config)
    app_type = app_config.get('app_type')
    if app_type != 'universal-app':
        error_msg = 'app_type invalid'
        return None, api_error(status.HTTP_403_FORBIDDEN, error_msg)

    pages = app_config.get('settings', {}).get('pages')
    page = next(filter(lambda x: x.get('id') == page_id, pages), None)
    if not page:
        error_msg = 'page %s not found.' % page_id
        return None, api_error(status.HTTP_404_NOT_FOUND, error_msg)
    table_id = page['table_id']

    # metadata
    username = payload.get('username') or ''  # anonymous = ''
    dtable_server_api = DTableServerAPI(username, dtable_uuid, get_inner_dtable_server_url())
    dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
    try:
        if not use_plugin_metadata:
            metadata = dtable_server_api.get_metadata()
        else:
            metadata = dtable_server_api.get_metadata_with_plugin()
    except Exception as e:
        logger.error('get dtable: %s metadata error: %s', dtable_uuid, e)
        return None, api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
    # table
    tables = metadata.get('tables')
    table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
    if not table:
        error_msg = 'table %s not found.' % table_id
        return None, api_error(status.HTTP_404_NOT_FOUND, error_msg)
    columns_dict = {col['key']: col for col in table.get('columns', [])}
    # row
    try:
        sql = "SELECT * FROM `%(table)s` WHERE `_id`='%(row_id)s'" % {
            'table': table['name'],
            'row_id': row_id
        }
        resp_data = dtable_db_api.query(sql)
        rows = resp_data.get('results')
        if not rows:
            return None, api_error(status.HTTP_404_NOT_FOUND, 'Row not found')
        row = rows[0]
    except Exception as e:
        logger.exception('query row error: %s', e)

    shown_column_keys = page.get('shown_column_keys', [])
    if button_column_key not in shown_column_keys:
        return None, api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
    button_column = columns_dict.get(button_column_key)
    if not button_column:
        return None, api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
    column_data = button_column.get('data') or {}
    action_list = column_data.get('button_action_list') or []
    button_action = None
    for action in action_list:
        if action.get('action_type') == action_type and (action.get('_id') == action_id or action_type == 'lock_row'):
            button_action = action
            break
    if not button_action:
        return None, api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
    return {
        'username': username,
        'dtable': dtable,
        'metadata': metadata,
        'table': table,
        'columns_dict': columns_dict,
        'universal_app': universal_app,
        'button_action': button_action,
        'row': row
    }, None


class DTableUniversalAppsLockRowViaButtonView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def put(self, request, app_uuid):
        try:
            asset, error = check_via_button_request(request, app_uuid, 'lock_row')
            if error:
                return error
        except Exception as e:
            logger.exception(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        username = asset.get('username')
        dtable = asset.get('dtable')
        table = asset.get('table')
        row = asset.get('row')
        try:
            dtable_server_api = DTableServerAPI(username, str(dtable.uuid), get_inner_dtable_server_url())
            dtable_server_api.lock_rows(table['name'], [row['_id']])
        except Exception as e:
            logger.exception('app: %s lock row via button error: %s', app_uuid, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'success': True}, status=status.HTTP_200_OK)


class DTableUniversalAppsModifyRowViaButtonView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def put(self, request, app_uuid):
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_data = request.data.get('row_data')
        if not row_data or not isinstance(row_data, dict):
            error_msg = 'row_data invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id = request.data.get('row_id')
        if not row_id:
            return api_error(status.HTTP_400_BAD_REQUEST, 'row_id invalid')

        button_column_key = request.data.get('button_column_key')
        if not button_column_key:
            return api_error(status.HTTP_400_BAD_REQUEST, 'button_column_key invalid')

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_id = page.get('table_id')

        # metadata
        username = payload.get('username') or ''  # anonymous = ''
        dtable_server_api = DTableServerAPI(username, dtable_uuid, get_inner_dtable_server_url())
        try:
            metadata = dtable_server_api.get_metadata()
        except Exception as e:
            logger.error('get dtable: %s metadata error: %s', dtable_uuid, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')
        columns_dict = {col['key']: col for col in table.get('columns', [])}

        shown_column_keys = page.get('shown_column_keys', [])
        if button_column_key not in shown_column_keys:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
        button_column = columns_dict.get(button_column_key)
        if not button_column:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
        column_data = button_column.get('data') or {}
        action_list = column_data.get('button_action_list') or []
        modify_row_action = None
        for action in action_list:
            if action.get('action_type') == 'modify_row':
                modify_row_action = action
                break
        if not modify_row_action:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')

        try:
            dtable_server_api.update_row(table_name, row_id, row_data)
        except Exception as e:
            logger.exception('app: %s modify row via button error: %s', app_uuid, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'success': True}, status=status.HTTP_200_OK)


class DTableUniversalAppsPublicUploadLinkView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        """ upload link
        """
        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not check_quota_by_workspace(dtable.workspace):
            error_msg = 'Asset quota exceeded.'
            return api_error(HTTP_443_ABOVE_QUOTA, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)
        username = payload.get('username')
        if not username:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
        if not check_dtable_admin_permission(username, dtable.workspace.owner):
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')

        parent_dir = os.path.join('/asset', str(dtable.uuid), PUBLIC_RELATIVE_PATH)

        try:
            public_upload_link = generate_upload_link(parent_dir, dtable)
        except Exception as e:
            logger.error('generate upload link error: %s, parent_dir: %s', e, parent_dir)

        return Response({
            'parent_path': parent_dir,
            'upload_link': public_upload_link
        })


class DTableUniversalAppsUploadLinkView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        """ upload link
        """
        upload_type = request.GET.get('upload_type', 'file')
        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not check_quota_by_workspace(dtable.workspace):
            error_msg = 'Asset quota exceeded.'
            return api_error(HTTP_443_ABOVE_QUOTA, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid = is_valid_app_jwt(auth, app_uuid)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
