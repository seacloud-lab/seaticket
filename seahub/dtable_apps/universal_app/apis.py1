        username = payload.get('username') or ''  # anonymous = ''
        app_config = json.loads(external_app.app_config)
        app_settings = app_config.get('settings', {})
        app_pages = app_settings.get('pages', [])
        app_page = None
        for page in app_pages:
            if page['id'] == app_page_id:
                app_page = page
