        if upload_type == 'digital-sign':
            parent_dir = '/asset/%s' % str(dtable.uuid)
        else:
            parent_dir = '/asset/%s/external-apps' % str(dtable.uuid)

        try:
            upload_link = generate_upload_link(parent_dir, dtable)
        except Exception as e:
            logger.error('generate upload link error: %s, parent_dir: %s', e, parent_dir)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        img_relative_path = 'images/%s' % str(datetime.today())[:7]
        file_relative_path = 'files/%s' % str(datetime.today())[:7]
        digital_signs_relative_path = 'digital-signs/%s' % str(datetime.today())[:7]

        return Response({
            'upload_link': upload_link,
            'parent_path': parent_dir,
            'img_relative_path': img_relative_path,
            'file_relative_path': file_relative_path,
            'digital_signs_relative_path': digital_signs_relative_path
        })


