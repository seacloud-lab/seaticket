        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'success': True})


class DTableUniversalAppsLinksBatchView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid):
        """
            add link
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        link_infos = request.data.get('link_infos', [])
        if not link_infos:
            error_msg = 'link_infos invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = link_infos[0].get('table_id')
        other_table_ids = [link_info.get('other_table_id') for link_info in link_infos]

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if page.get('type') != 'table':
            error_msg = 'page %s not a table' % page_id
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if page.get('table_id') != table_id:
            error_msg = 'page %s table %s invalid' % (page_id, table_id)
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if not app_page_can_modify(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        for other_table_id in other_table_ids:
            other_table = next(filter(lambda x: x.get('_id') == other_table_id, tables), None)
            if not other_table:
                error_msg = 'table %s or table %s not found.' % (table_id, other_table_id)
                return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # batch update links
        base_db = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            for link_info in link_infos:
                base_db.batch_append_links(link_info)
        except ConnectionError as e:
            if len(e.args) == 2:
                status_code = e.args[0]
                if 400 <= status_code < 500:
                    logger.warning('batch append links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
                    return api_error(status_code, 'Bad request')
            logger.error('batch append links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except requests.Timeout as e:
            logger.error('batch append dtable-db links dtable: %s data: %s timeout error: %s', dtable_uuid, link_infos, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        except Exception as e:
            logger.error('batch append dtable-db links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response({'success': True})

    def delete(self, request, app_uuid):
        """
            delete links
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        link_infos = request.data.get('link_infos', [])
        if not link_infos:
            error_msg = 'link_infos invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        table_id = link_infos[0].get('table_id')
        other_table_ids = [link_info.get('other_table_id') for link_info in link_infos]

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if page.get('type') != 'table':
            error_msg = 'page %s not a table' % page_id
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if page.get('table_id') != table_id:
            error_msg = 'page %s table %s invalid' % (page_id, table_id)
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        if not app_page_can_modify(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        for other_table_id in other_table_ids:
            other_table = next(filter(lambda x: x.get('_id') == other_table_id, tables), None)
            if not other_table:
                error_msg = 'table %s or table %s not found.' % (table_id, other_table_id)
                return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # batch delete links
        base_db = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            for link_info in link_infos:
                base_db.batch_delete_links(link_info)
        except ConnectionError as e:
            if len(e.args) == 2:
                status_code = e.args[0]
                if 400 <= status_code < 500:
                    logger.warning('batch delete links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
                    return api_error(status_code, 'Bad request')
            logger.error('batch delete links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except requests.Timeout as e:
            logger.error('batch delete dtable-db links dtable: %s data: %s timeout error: %s', dtable_uuid, link_infos, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        except Exception as e:
            logger.error('batch delete dtable-db links dtable: %s data: %s error: %s', dtable_uuid, link_infos, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response({'success': True})


class DTableAppElementStatistic(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle, )

    def post(self, request, app_uuid):

        # argument check
        page_id = request.data.get("page_id", None)
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        element_id = request.data.get("element_id", None)
        if not element_id:
            error_msg = 'element_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        try:
            universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        except DTableExternalApps.DoesNotExist:
            error_msg = 'universal app %s does not exist.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        if not universal_app:
            error_msg = 'universal app %s does not exist.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''

        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        page_content_url = page.get('content_url')
        if not page_content_url:
            error_msg = 'content of page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        try:
            if 'external-apps' not in page_content_url:
                # relative path
                path = 'external-apps/' + page_content_url.strip('/')
            else:
                external_apps_index = page_content_url.index('external-apps')
                path = page_content_url[external_apps_index:]

            asset_name = os.path.basename(normalize_file_path(path))
            repo_id = dtable.workspace.repo_id
            asset_path = normalize_file_path(os.path.join('/asset', dtable_uuid, path))
            asset_id = seafile_api.get_file_id_by_path(repo_id, asset_path)

            token = seafile_api.get_fileserver_access_token(
                repo_id, asset_id, 'view', '', use_onetime=False
            )
            url = gen_file_get_url(token, asset_name)
            response = requests.get(url, timeout=TIMEOUT)
            if response.status_code == 429:
                error_msg = _('Too many users use the statistic. Please try again later.')
                return api_error(status.HTTP_429_TOO_MANY_REQUESTS, error_msg)
            if response.status_code >= 400:
                logger.error('request seafile custom page file: %s error status code: %s response: %s', url, response.status_code, response.text)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            page_content = response.json()
        except requests.Timeout as e:
            logger.error('get dtable: %s asset: %s timeout error: %s', dtable_uuid, asset_path, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('request seafile custom page file: %s error: %s', url, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        page_content_map = page_content.get('block_by_id', {})
        element = page_content_map.get(element_id)

        if not element:
            error_msg = 'element %s not found' % element_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        element_type = element.get('type')
        if element_type == 'chart_bar':
            element_type = 'statistic'
        if element_type != 'statistic':
            error_msg = 'element %s of type is not statistic' % element_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        element_config = element.get('config')
        statistic_type = element_config.get('type', 'bar')
        table_id = element_config.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # generator sql
        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''

        import dtable_events

        sql, error = dtable_events.statistic2sql(table, statistic_type, element_config, username, id_in_org)

        if error:
            return api_error(status.HTTP_404_NOT_FOUND, error)

        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)

        try:
            if not isinstance(sql, list):
                res_data = dtable_db_api.query(sql)
                return Response(res_data)
            else:
                new_res = {
                    'success': True,
                    'results': [],
                }
                for sql_item in sql:
                    if not sql_item:
                        new_res['results'].append([])
                    else:
                        res_data = dtable_db_api.query(sql_item)
                        new_res['results'].append(res_data['results'])
                return Response(new_res)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        except Exception as e:
            logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)


class DTableUniversalAppRunScriptView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid, script_name):
        # arguments check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        pages = app_config.get('settings', {}).get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid, include_deleted=False)
        if not dtable:
            error_msg = 'Base %s not found' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not can_run_python_by_dtable(dtable):
            error_msg = 'Permission denied'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # script check
        repo_id = dtable.workspace.repo_id
        script_path = os.path.join('/asset', str(dtable.uuid), 'scripts', script_name)
        asset_id = seafile_api.get_file_id_by_path(repo_id, script_path)
        if not asset_id:
            return api_error(status.HTTP_404_NOT_FOUND, 'Script not found.')

        token = seafile_api.get_fileserver_access_token(
            repo_id, asset_id, 'download', '', use_onetime=True)
        if not token:
            return api_error(status.HTTP_404_NOT_FOUND, 'Script not found.')

        # script_url
        script_url = gen_file_get_url(token, script_name)

        # temp_api_token
        temp_api_token = jwt.encode({
            'dtable_uuid': dtable_uuid,
            'app_name': script_name,
            'exp': int(time.time()) + 60 * 15,
        }, SEATABLE_FAAS_AUTH_TOKEN, algorithm='HS256')

        context_data = request.data

        owner = dtable.workspace.owner
        # org_id
        org_id, scripts_running_limit = -1, -1
        if MULTI_TENANCY:
            if '@seafile_group' not in owner:
                orgs = ccnet_api.get_orgs_by_user(owner)
                if orgs:
                    org_id = orgs[0].org_id
            else:
                group_id = owner[:owner.find('@seafile_group')]
                org_id = ccnet_api.get_org_id_by_group(int(group_id))

        if org_id != -1:
            scripts_running_limit = OrgQuota.objects.get_scripts_running_limit(org_id)
        elif org_id == -1 and '@seafile_group' not in owner:
            scripts_running_limit, error = UserQuota.objects.get_scripts_running_limit(owner)
            if error:
                return api_error(status.HTTP_404_NOT_FOUND, error)

        # call faas func, return script_id
        headers = {'Authorization': 'Token ' + SEATABLE_FAAS_AUTH_TOKEN}
        url = SEATABLE_FAAS_URL.strip('/') + '/run-script/'

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else None

        if isinstance(context_data, dict):
            context_data['current_user_id'] = username
            context_data['current_username'] = username
            context_data['current_id_in_org'] = id_in_org

        data = {
            'dtable_uuid': str(dtable.uuid),
            'script_name': script_name,
            'context_data': context_data,
            'owner': owner,  # workspace's owner
            'org_id': org_id,
            'script_url': script_url,
            'temp_api_token': temp_api_token,
            'scripts_running_limit': scripts_running_limit,
        }
        try:
            response = requests.post(url, json=data, headers=headers, timeout=10)
        except requests.Timeout as e:
            logger.error('run script dtable: %s data: %s timeout error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.error('run script dtable: %s data: %s error: %s', dtable_uuid, data, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')
        else:
            if response.status_code != 200:
                return api_error(response.status_code, response.text)
            # script_id
            try:
                script = response.json()
            except Exception as err:
                logger.error('run script error: %s, err: %s', err, response.content)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response(script)


class DTableUniversalAppNotificationViaButtonView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid):
        try:
            asset, error = check_via_button_request(request, app_uuid, 'send_notification')
            if error:
                return error
        except Exception as e:
            logger.exception(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        dtable = asset.get('dtable')
        send_notification_action = asset.get('button_action')
        table = asset.get('table')
        row = asset.get('row')
        username = asset.get('username')

        dtable_uuid = str(dtable.uuid)
        to_users = send_notification_action.get('to_users', [])
        emails = [to_user.get('value') for to_user in to_users]
        user_col_key = send_notification_action.get('user_col_key')
        message = fill_message_by_dtable_db(username, dtable_uuid, table['name'], row['_id'], send_notification_action.get('msg', ''))

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid, include_deleted=False)
        if not dtable:
            error_msg = 'Base %s not found' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        params = {
            'dtable_uuid': dtable_uuid,
            'username': username,
            'emails': emails and ','.join(emails) or None,
            'msg': message,
            'table_id': table['_id'],
            'row_id': row['_id'],
            'user_col_key': user_col_key
        }
        try:
            task_id = add_dtable_message_task(type=NOTIFICATION, params=params)
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        return Response({'task_id': task_id})


class DTableUniversalAppsEmailMessageSendViaButtonView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def _handle_file_path(self, dtable, repo_id, file_path):
        asset_path = normalize_file_path(os.path.join('/asset', str(dtable.uuid), file_path))
        asset_id = seafile_api.get_file_id_by_path(repo_id, asset_path)
        asset_name = os.path.basename(normalize_file_path(file_path))
        if not asset_id:
            err_msg = 'Asset file %s does not exist.' % asset_name
            err_code = 404
            return err_msg, err_code, None, None

        token = seafile_api.get_fileserver_access_token(
            repo_id, asset_id, 'download', '', use_onetime=False
        )

        url = gen_file_get_url(token, asset_name)
        return  None, 200, asset_name, url

    @staticmethod
    def is_valid_email(email):
        pattern = r'^([a-zA-Z0-9_.-])+@([a-zA-Z0-9_-])+(\.[a-zA-Z0-9_-]+)+$'
        return re.match(pattern, email) is not None

    @classmethod
    def get_emails(cls, email_str):
        if not isinstance(email_str, str):
            return []

        valid_emails = []
        email_list = email_str.split(',')

        for item in email_list:
            if cls.is_valid_email(item.strip()):
                valid_emails.append(item.strip())

        return valid_emails

    def post(self, request, app_uuid):
        try:
            asset, error = check_via_button_request(request, app_uuid, 'send_email')
            if error:
                return error
        except Exception as e:
            logger.exception(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        dtable = asset.get('dtable')
        send_email_action = asset.get('button_action')
        table = asset.get('table')
        columns_dict = asset.get('columns_dict')
        row = asset.get('row')
        username = asset.get('username')

        dtable_uuid = str(dtable.uuid)
        selectedAccount = send_email_action.get('selectedAccount')
        send_to_str = send_email_action.get('send_to')
        message_str = send_email_action.get('message')
        subject_str = send_email_action.get('subject')
        reply_to_str = send_email_action.get('reply_to')
        copy_to_str = send_email_action.get('copy_to')
        selectedAttachments = send_email_action.get('selectedAttachments')

        account_name = selectedAccount.get('value')
        send_to_str = fill_message_with_sql_row(send_to_str, table['columns'], row)
        send_to = self.get_emails(send_to_str)
        message = fill_message_with_sql_row(message_str, table['columns'], row)
        subject = fill_message_with_sql_row(subject_str, table['columns'], row)
        reply_to_str = fill_message_with_sql_row(reply_to_str, table['columns'], row)
        reply_to = self.get_emails(reply_to_str)
        copy_to_str = fill_message_with_sql_row(copy_to_str, table['columns'], row)
        copy_to = self.get_emails(copy_to_str)
        file_paths = []
        for attachment in selectedAttachments:
            column = columns_dict.get(attachment['key'])
            if not column or column.get('type') != 'file':
                continue
            files = row.get(column['key'], [])
            if not files:
                continue
            # file_paths.extend([file['url'] for file in files])
            for file in files:
                url = file['url']
                file_paths.append(unquote(url[url.find(dtable_uuid)+37:]))

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid, include_deleted=False)
        if not dtable:
            error_msg = 'Base %s not found' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        file_name_url_map = {}
        for file_path in file_paths:
            error_msg, err_code, file_name, file_url = self._handle_file_path(dtable, dtable.workspace.repo_id, file_path)
            if error_msg and err_code != 200:
                continue
            file_name_url_map[file_name] = file_url

        email_account = BoundThirdPartyAccounts.objects.get_accounts_by_dtable_and_name(dtable.uuid.hex, account_name)
        if not email_account:
            error_msg = 'Account does not exist.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if email_account.account_type != ACCOUNT_TYPE_EMAIL:
            error_msg = 'Account type is invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        account_detail = _decrypt_detail(json.loads(email_account.detail))
        if not account_detail:
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        # main
        params = {
            'email_host': account_detail.get('email_host', ''),
            'email_port': account_detail.get('email_port'),
            'host_user': account_detail.get('host_user'),
            'password': account_detail.get('password'),
            'sender_name': account_detail.get('sender_name', ''),

            'send_to': send_to,
            'message': message,
            'subject': subject,
            'copy_to': copy_to,
            'reply_to': reply_to,
            'username': username,
            'file_download_urls': json.dumps(file_name_url_map)
        }

        message_id = ''

        try:
            task_id = add_dtable_message_task(type=ACCOUNT_TYPE_EMAIL, params=params)
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        return Response({'task_id': task_id, 'message_id': message_id})


