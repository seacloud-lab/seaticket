class DTableUniversalAppSnapshotRowsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid, snapshot_id):
        """ list page rows
        """
        page_id = request.GET.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        start = request.GET.get('start', 0)
        limit = request.GET.get('limit', 100)
        try:
            start = int(start)
            limit = int(limit)
        except ValueError:
            start = 0
            limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        app_snapshot = DTableAppSnapshot.objects.filter(
            app = universal_app,
            id = snapshot_id
        ).first()

        if not app_snapshot:
            error_msg = 'app snapshot not found'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)


        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(app_snapshot.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        # main
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        table_id = page.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')
        columns = table.get('columns')
        table_column_keys = [col.get('key') for col in columns]
        shown_column_keys = page.get('shown_column_keys', [])
        shown_title_column_key = page.get('shown_title_column_key')
        shown_image_column_key = page.get('shown_image_column_key')
        if shown_title_column_key and shown_title_column_key not in shown_column_keys:
            shown_column_keys.append(shown_title_column_key)
        if shown_image_column_key and shown_image_column_key not in shown_column_keys:
            shown_column_keys.append(shown_image_column_key)

        if not shown_column_keys:
            error_msg = 'shown_column_keys is empty.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        shown_column_names = ['`' + column.get('name', '') + '`'
            for column in columns if column.get('key') in shown_column_keys]
        shown_column_names.append('`_id`')
        shown_column_names.append('`_archived`')
        shown_column_names.append('`_locked`')

        filters = page.get('filters', [])
        filter_conjunction = page.get('filter_conjunction', 'And')
        sorts = page.get('sorts', [])

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''
        user_department_ids_map = get_departments_map_by_username(username)
        current_user_department_ids = user_department_ids_map['current_user_department_ids']
        current_user_department_and_sub_ids = user_department_ids_map['current_user_department_and_sub_ids']

        filter_conditions = {
            'start': start,
            'limit': limit,
        }
        if sorts:
            filter_conditions['sorts'] = sorts

        if filters:
            for item in filters:
                column_key = item.get('column_key')
                filter_term = item.get('filter_term')
                filter_predicate = item.get('filter_predicate')
                if column_key not in table_column_keys:
                    error_msg = 'some columns in the pre-filter has been deleted.'
                    return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
                if filter_predicate == 'include_me':
                    item['filter_term'].append(username)
                if filter_predicate == 'is_current_user_ID':
                    item['filter_term'] = id_in_org
                if filter_term == 'current_user_department':
                    item['filter_term'] = current_user_department_ids
                if filter_term == 'current_user_department_and_sub':
                    item['filter_term'] = current_user_department_and_sub_ids
                if isinstance(filter_term, list):
                    if 'current_user_department' in filter_term or 'current_user_department_and_sub' in filter_term:
                        for i in range(len(filter_term)):
                            if filter_term[i] == 'current_user_department':
                                filter_term[i] = current_user_department_ids
                            elif filter_term[i] == 'current_user_department_and_sub':
                                filter_term[i] = current_user_department_and_sub_ids
                        flat_result = [item for sublist in filter_term for item in (sublist if isinstance(sublist, list) else [sublist])]
                        item['filter_term'] = list(set(flat_result))
            filter_conditions['filters'] = filters
            filter_conditions['filter_conjunction'] = filter_conjunction

        import dtable_events

        try:
            sql = dtable_events.filter2sql(
                table_name, columns, filter_conditions, by_group=False)
            sql = sql.replace('*', ', '.join(shown_column_names), 1)
        except dtable_events.SQLGeneratorOptionInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        except dtable_events.DateTimeQueryInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        except Exception as e:
            logger.exception('app_uuid: %s snapshot: %s page_id: %s row error: %s', app_uuid, snapshot_id, page_id, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            resp_json = dtable_db_api.query(sql)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sq;: %s timeout error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response(resp_json, status=status.HTTP_200_OK)


class DTableAppSnapshotElementStatistic(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid, snapshot_id):

        # argument check
        page_id = request.data.get("page_id", None)
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        element_id = request.data.get("element_id", None)
        if not element_id:
            error_msg = 'element_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)


        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'universal app %s does not exist.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        if not universal_app:
            error_msg = 'universal app %s does not exist.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        app_snapshot = DTableAppSnapshot.objects.filter(
            app = universal_app,
            id = snapshot_id
        ).first()

        if not app_snapshot:
            error_msg = 'app snapshot not found.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(app_snapshot.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''

        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        page_content_url = page.get('content_url')
        if not page_content_url:
            error_msg = 'content of page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        try:
            if 'external-apps' not in page_content_url:
                # relative path
                src_path = 'external-apps/' + page_content_url.strip('/')
            else:
                external_apps_index = page_content_url.index('external-apps')
                src_path = page_content_url[external_apps_index:]

            path_dir = os.path.dirname(src_path)


            asset_name = os.path.basename(normalize_file_path(src_path))
            path = os.path.join(path_dir, 'custom_page_backup_%s' % snapshot_id, asset_name)
            repo_id = dtable.workspace.repo_id
            asset_path = normalize_file_path(os.path.join('/asset', dtable_uuid, path))
            asset_id = seafile_api.get_file_id_by_path(repo_id, asset_path)

            token = seafile_api.get_fileserver_access_token(
                repo_id, asset_id, 'view', '', use_onetime=False
            )
            url = gen_file_get_url(token, asset_name)
            response = requests.get(url, timeout=TIMEOUT)
            if response.status_code == 429:
                error_msg = _('Too many users use the statistic. Please try again later.')
                return api_error(status.HTTP_429_TOO_MANY_REQUESTS, error_msg)
            if response.status_code >= 400:
                logger.error('request seafile custom page file: %s error status code: %s response: %s', url, response.status_code, response.text)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            page_content = response.json()
        except requests.Timeout as e:
            logger.error('request seafile custom page file: %s timeout error: %s', url, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('request seafile custom page file: %s error: %s', url, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        page_content_map = page_content.get('block_by_id', {})
        element = page_content_map.get(element_id)

        if not element:
            error_msg = 'element %s not found' % element_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        element_type = element.get('type')
        if element_type == 'chart_bar':
            element_type = 'statistic'
        if element_type != 'statistic':
            error_msg = 'element %s of type is not statistic' % element_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        element_config = element.get('config')
        statistic_type = element_config.get('type', 'bar')
        table_id = element_config.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # generator sql
        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''

        import dtable_events

        sql, error = dtable_events.statistic2sql(table, statistic_type, element_config, username, id_in_org)

        if error:
            return api_error(status.HTTP_404_NOT_FOUND, error)

        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            resp_json = dtable_db_api.query(sql)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        return Response(resp_json)


class DTableAppRelatedUsersView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def _list_user_info(self, email_list):
        user_list = []
        email2id_in_org = IdInOrgTuple.objects.gen_virtual_id2id_in_org_dict(email_list)

        for email in email_list:
            user_info = get_user_common_info(email, include_contact_email=False)
            user_info['id_in_org'] = email2id_in_org.get(email, '')
            user_name = user_info.get('name', '')
            user_info['name_pinyin'] = "'".join(lazy_pinyin(user_name)) if user_name else ''
            user_list.append(user_info)
        return user_list

    def get(self, request, app_uuid):
        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        try:
            current_page = int(request.GET.get('page', 1))
            per_page = int(request.GET.get('per_page', DTABLE_RELATED_USERS_PER_PAGE))
        except ValueError:
            current_page = 1
            per_page = DTABLE_RELATED_USERS_PER_PAGE

        user_list_cache, app_user_list_cache = None, None
        # use cache
        if current_page == 1 and per_page == DTABLE_RELATED_USERS_PER_PAGE:
            user_list_cache = list_dtable_related_users_info(dtable_uuid)
            app_user_list_cache = list_dtable_app_users_info(dtable_uuid)
            if user_list_cache is not None and app_user_list_cache is not None:
                return Response({
                    'user_list': user_list_cache,
                    'app_user_list': app_user_list_cache,
                    })

        # user_list
        if user_list_cache is None:
            start = (current_page - 1) * per_page
            end = start + per_page
            try:
                email_list = list_dtable_related_users(dtable.workspace, dtable)[start:end]
                user_list = self._list_user_info(email_list)
            except Exception as e:
                logger.exception(e)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            if current_page == 1 and per_page == DTABLE_RELATED_USERS_PER_PAGE:
                set_related_users_info_cache(dtable_uuid, user_list)
        else:
            user_list = user_list_cache

        # app_user_list [:DTABLE_APP_USERS_PER_PAGE]
        if app_user_list_cache is None:
            try:
                email_list = list_dtable_app_users(dtable.uuid.hex)
                app_user_list = self._list_user_info(email_list)
            except Exception as e:
                logger.error(e)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            if current_page == 1:
                set_app_users_info_cache(dtable_uuid, app_user_list)
        else:
            app_user_list = app_user_list_cache

        return Response({
            'user_list': user_list,
            'app_user_list': app_user_list,
            })



def _resource_check(username, dtable_uuid, table_id, row_id):
    error, metadata = get_metadata(dtable_uuid)
    if error:
        return error
    tables = metadata.get('tables')
    table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
    if not table:
        error_msg = 'table %s not found.' % table_id
        return api_error(status.HTTP_404_NOT_FOUND, error_msg)
    table_name = table.get('name')
    dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)

    sql = """select `_id` from `%(table_name)s` where `_id` = '%(row_id)s' """ % ({
        'table_name': table_name,
        'row_id': row_id
    })
    try:
        query_result = dtable_db_api.query(sql)
        row = query_result.get('results', None)
        if not row:
            error_msg = 'row %s not found' % row_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
    except Exception as e:
        logger.error(e)
        return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')


    return None


class DTableUniversalAppRowCommentsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):

        # resource check
        try:
            page = int(request.GET.get('page', 1))
            per_page = int(request.GET.get('per_page', 25))
        except:
            page, per_page = 1, 25

        start = (page - 1) * per_page
        end = page * per_page

        table_id = request.GET.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id = request.GET.get('row_id', None)
        if not row_id:
            error_msg = 'row_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        related_base_uuids = universal_app.related_base_uuids
        try:
            dtable_uuid = uuid_str_to_36_chars(request.GET.get('dtable_uuid', None))
        except:
            dtable_uuid = None

        if (not dtable_uuid) or (dtable_uuid not in related_base_uuids):
            error_msg = 'dtable_uuid invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username')

        # dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        app_pages = app_config.get('settings', {}).get('pages', [])
        app_table_ids = [page.get('table_id') for page in app_pages]
        if table_id not in app_table_ids:
            error_msg = 'table_id %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        error = _resource_check(username, dtable_uuid, table_id, row_id)
        if error:
            return error

        # main logic
        try:
            app_row_comments, count = DTableAppRowComments.objects.list_row_comments(
                universal_app, dtable_uuid, table_id, row_id, start, end
            )
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'row_comments': [comment.to_dict() for comment in app_row_comments], 'count': count})

    def post(self, request, app_uuid):

        # resource check
        table_id = request.data.get('table_id', None)
        if not table_id:
            error_msg = 'table_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_id = request.data.get('row_id', None)
        if not row_id:
            error_msg = 'row_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        comment = request.data.get('comment', None)
        if not comment:
            error_msg = 'comment info invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        participants = request.data.get('participants', None) # username list, optional
        if participants:
            if not isinstance(participants, list):
                return api_error(status.HTTP_400_BAD_REQUEST, 'participants invalid')

        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        related_base_uuids = universal_app.related_base_uuids
        try:
            dtable_uuid = uuid_str_to_36_chars(request.data.get('dtable_uuid', None))
        except:
            dtable_uuid = None

        if (not dtable_uuid) or (dtable_uuid not in related_base_uuids):
            error_msg = 'dtable_uuid invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        app_user_obj = check_app_user(universal_app, username)
        if not app_user_obj:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)


        app_pages = app_config.get('settings', {}).get('pages', [])
        app_table_ids = [page.get('table_id') for page in app_pages]
        if table_id not in app_table_ids:
            error_msg = 'table_id %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        error = _resource_check(username, dtable_uuid, table_id, row_id)
        if error:
            return error

        # main logic

        # 1. add a comment
        try:
            new_comment = DTableAppRowComments.objects.add_comment(
                universal_app,
                dtable_uuid,
                username,
                comment,
                table_id,
                row_id
            )

            # 2. add participants including self
            if participants:
                paticipant_list = participants + [username, ]
            else:
                paticipant_list = [username, ]
            for participant in paticipant_list:
                DTableAppRowParticipants.objects.add_participant(
                    universal_app,
                    dtable_uuid,
                    participant,
                    table_id,
                    row_id,
                )

            # 3. get row participants
            row_participants = DTableAppRowParticipants.objects.list_participants(
                universal_app,
                dtable_uuid,
                table_id,
                row_id
            )

            # 4. send a signal for notification
            new_app_row_comment.send(
                None,
                app=universal_app,
                username=username,
                row_participants=row_participants,
                detail=new_comment.notes
            )
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')


        return Response({'row_comment': new_comment.to_dict()})

class DTableUniversalAppRowCommentView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def put(self, request, app_uuid, comment_id):

        try:
            resolved = request.data.get('resolved')
            if resolved is not None:
                if not isinstance(resolved, bool):
                    resolved = to_python_boolean(resolved)
        except:
            error_msg = 'params invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username', '')
        app_user_obj = check_app_user(universal_app, username)
        if not app_user_obj:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        comment = DTableAppRowComments.objects.filter(
            pk = comment_id,
            app = universal_app,
        ).first()

        if not comment:
            error_msg = 'Comment not found.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # main logic
        try:
            if resolved is not None:
                comment.resolved = resolved
                comment.save()
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'row_comment': comment.to_dict()})

    def delete(self, request, app_uuid, comment_id):

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)


        app_config = json.loads(universal_app.app_config)
        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username')
        comment = DTableAppRowComments.objects.filter(pk=comment_id, app=universal_app).first()

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not comment:
            error_msg = 'Comment not found.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if comment.author != username and not check_dtable_admin_permission(username, dtable.workspace.owner):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg) 

        # main logic
        try:
            comment.delete()
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'success': True})

class DTableAppRowCommentsWithinDaysView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        # arguments
        try:
            days = int(request.GET.get('days', 7))
        except:
            days = 7
        if days <= 0:
            return api_error(status.HTTP_400_BAD_REQUEST, 'days invalid.')

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, _ = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        last_time = datetime.now() - timedelta(days=days)
        comments = DTableAppRowComments.objects.filter(app__app_uuid=app_uuid, created_at__gte=last_time).order_by('id')
        return Response({'comment_list': [comment.to_dict() for comment in comments]})

