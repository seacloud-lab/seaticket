class DTableUniversalAppsSubmitForm(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle, )

    def post(self, request, app_uuid):

        # argument check
        row_data = request.data.get("row_data", None)
        link_rows = request.data.get('link_rows', [])
        new_linked_rows = request.data.get('new_linked_rows', [])
        if not row_data and not link_rows and not new_linked_rows:
            error_msg = 'row_data or link_rows invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # argument check
        app_page_id = request.data.get("app_page_id", None)
        if not app_page_id:
            error_msg = 'app_page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        try:
            external_app = DTableExternalApps.objects.get_external_app_by_uuid(app_uuid)
        except DTableExternalApps.DoesNotExist:
            error_msg = 'app does not exist.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if external_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = external_app.dtable_uuid
        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'Base %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        app_config = json.loads(external_app.app_config)
        app_settings = app_config.get('settings', {})
        app_pages = app_settings.get('pages', [])
        app_form_page = None
        for page in app_pages:
            if page['id'] == app_page_id:
                app_form_page = page

        if not app_form_page:
            return api_error(status.HTTP_404_NOT_FOUND, 'form page not found')

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)
        username = payload.get('username') or ''  # anonymous = ''

        if not app_page_can_submit_form(payload, app_form_page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # get dtable columns from metadata
        dtable_server_url = get_inner_dtable_server_url()
        try:
            error, metadata = get_metadata(dtable_uuid)
            if error:
                return error
            tables = metadata['tables']
            table = next(filter(lambda x: x.get('_id') == app_form_page.get('table_id'), tables), None)
            if not table:
                return api_error(status.HTTP_404_NOT_FOUND, 'Table not found')
            table_name = table['name']
            columns = table['columns']
        except Exception as e:
            logger.error('query dtable-db metadata dtable: %s error: %s', dtable_uuid, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        page_duplicate_record_setting = app_form_page.get('add_duplicate_record_setting') or {}
        duplicate_prohibition = page_duplicate_record_setting.get('duplicate_prohibition')
        if duplicate_prohibition:
            unique_column_keys = page_duplicate_record_setting.get('unique_column_keys', [])
            dtable_db_api = DTableDBAPI(username, uuid_str_to_36_chars(dtable_uuid), INNER_DTABLE_DB_URL)
            try:
                res = _check_row_data_exists(row_data, table, unique_column_keys, dtable_db_api)
            except ValueEmptyError as e:
                error_msg = "Column %s cannot be empty" % e.name
                return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

            if res:
                error_msg = 'Cannot_add_same_records'
                return api_error(status.HTTP_409_CONFLICT, error_msg)

        # migrate image files from assets/xxx/forms/xxx to assets/xxx/images/xxx
        row_data_dict = row_data

        form_column_keys = [col['key'] for col in app_form_page['columns']]
        image_col_names = [col['name'] for col in columns if col['key'] in form_column_keys and col['type'] == 'image']
        long_text_col_names = [col['name'] for col in columns if col['key'] in form_column_keys and col['type'] == 'long-text']
        for name in image_col_names:
            image_links = row_data_dict.get(name)
            if not image_links:
                continue
            new_links = []
            for link in image_links:
                try:
                    new_link = migrate_image(link, dtable, PUBLIC_FORMS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, username='form')
                except Exception as e:
                    logger.error('migrate image: %s from: %s to: %s error: %s', link, PUBLIC_FORMS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, e)
                    return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
                if not new_link:
                    new_link = link
                new_links.append(new_link)
            row_data_dict[name] = new_links

        for name in long_text_col_names:
            long_text_value = row_data_dict.get(name, {})
            if not long_text_value:
                continue
            long_text_images = long_text_value.get('images', [])
            if (len(long_text_images) == 0):
                row_data_dict[name] = long_text_value.get('text', '')
            else:
                long_text_text = long_text_value.get('text', '')
                new_long_text_images = []
                for long_text_image in long_text_images:
                    try:
                        new_link = migrate_image(long_text_image, dtable, PUBLIC_FORMS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, username='form')
                    except Exception as e:
                        logger.error('migrate image: %s from: %s to: %s error: %s', long_text_image, PUBLIC_FORMS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, e)
                        return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
                    if not new_link:
                        new_link = long_text_image
                    new_long_text_images.append(new_link)
                    long_text_text = long_text_text.replace(long_text_image.strip(), new_link)
                long_text_value['text'] = long_text_text
                long_text_value['images'] = new_long_text_images
                row_data_dict[name] = long_text_value

        try:
            base = DTableServerAPI(username, dtable_uuid, dtable_server_url)

            # 1. add main table row
            row = base.append_row(table['name'], row_data_dict, apply_default=True)
            # 2. submit/update links
            submit_and_update_links(base, table, tables, row['_id'], link_rows, new_linked_rows, apply_default=True)
            row_id = row['_id']
        except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        trigger_workflow_option = app_form_page.get('trigger_workflow_option')
        is_trigger_workflow = trigger_workflow_option.get('is_trigger_workflow')
        workflow_token = trigger_workflow_option.get('workflow_token')

        if ENABLE_WORKFLOW and is_trigger_workflow:
            try:
                user = User.objects.get(email=username)
            except User.DoesNotExist:
                user = None

            if MULTI_TENANCY:
                orgs = ccnet_api.get_orgs_by_user(username)
                if orgs:
                    user.org = orgs[0]
            request.user = user

        if ENABLE_WORKFLOW and is_trigger_workflow and request.user and request.user.is_authenticated:
            workflow = DTableWorkflows.objects.get_workflow_by_token(workflow_token)
            if not workflow:
                logger.warning('app: %s trigger workflow: %s not found', app_uuid, workflow_token)
            else:
                if isinstance(request.data, QueryDict):
                    request.data._mutable = True

                request.data['row_id'] = row_id
                request.data['app_uuid'] = app_uuid

                try:
                    submit_workflow_result = DTableWorkflowSubmitTaskView().post(request, workflow_token)
                except Exception as e:
                    logger.exception(e)
                    logger.error('universal app trigger workflow failed error: %s', e)
                else:
                    if submit_workflow_result.status_code != 200:
                        resp_data = submit_workflow_result.data
                        logger.error('universal app trigger workflow failed status code: %s error_msg: %s', submit_workflow_result.status_code, resp_data)

        """
            # todo: send notification
            notification = external_app_page.get('notification', {})
        """

        # end remark
        success_message_option = app_form_page.get('success_message_option') or {}
        success_message = ''
        if success_message_option.get('is_success_message_show', False):
            success_message = success_message_option.get('success_message') or ''
            success_message = fill_message_by_dtable_db(username, str(dtable.uuid), table_name, row_id, success_message)

        return Response({"success": True, "success_message": success_message})


class DTableUniversalAppsLinkedTableRowsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        # argument check
        app_page_id = request.GET.get("page_id", None)
        if not app_page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        link_column_key = request.GET.get("link_column_key", None)
        if not link_column_key:
            error_msg = 'link_column_key invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)


        try:
            start = int(request.GET.get("start", 0))
        except ValueError:
            start = 0

        try:
            limit = int(request.GET.get("limit", 10000))
        except ValueError:
            limit = 10000

        try:
            external_app = DTableExternalApps.objects.get_external_app_by_uuid(app_uuid)
        except DTableExternalApps.DoesNotExist:
            error_msg = 'app does not exist.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if external_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = external_app.dtable_uuid
        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'Base %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        app_config = json.loads(external_app.app_config)
        app_settings = app_config.get('settings', {})
        app_pages = app_settings.get('pages', [])
        app_page = None
        for page in app_pages:
            if page['id'] == app_page_id:
                app_page = page
                break

        if not app_page:
            return api_error(status.HTTP_404_NOT_FOUND, 'form page not found')

        if app_page['type'] == 'form':
            page_columns = app_page.get('columns', [])
        elif _can_modify_link_column(app_page):
            page_columns = app_page.get('link_columns_settings', [])
        else:
            return api_error(status.HTTP_400_BAD_REQUEST, 'Page has no link column settings')
        link_column = {}
        for col in page_columns:
            if col.get('key') == link_column_key:
                link_column = col
                break

        link_filters = link_column.get('link_filters', [])
        link_filter_conjunction = link_column.get('link_filter_conjunction')

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''

        user_department_ids_map = get_departments_map_by_username(username)
        current_user_department_ids = user_department_ids_map['current_user_department_ids']
        current_user_department_and_sub_ids = user_department_ids_map['current_user_department_and_sub_ids']
        filter_conditions = {
            'start': start,
            'limit': limit,
        }

        if link_filters:
            for item in link_filters:
                filter_term = item.get('filter_term')
                filter_predicate = item.get('filter_predicate')
                if filter_predicate == 'include_me':
                    item['filter_term'].append(username)
                if filter_predicate == 'is_current_user_ID':
                    item['filter_term'] = id_in_org
                if filter_term == 'current_user_department':
                    item['filter_term'] = current_user_department_ids
                if filter_term == 'current_user_department_and_sub':
                    item['filter_term'] = current_user_department_and_sub_ids
                if isinstance(filter_term, list):
                    if 'current_user_department' in filter_term or 'current_user_department_and_sub' in filter_term:
                        for i in range(len(filter_term)):
                            if filter_term[i] == 'current_user_department':
                                filter_term[i] = current_user_department_ids
                            elif filter_term[i] == 'current_user_department_and_sub':
                                filter_term[i] = current_user_department_and_sub_ids
                        flat_result = [item for sublist in filter_term for item in (sublist if isinstance(sublist, list) else [sublist])]
                        item['filter_term'] = list(set(flat_result))
            filter_conditions['filters'] = link_filters
            filter_conditions['filter_conjunction'] = link_filter_conjunction



        current_table_id = app_page.get('table_id')
        dtable_server_url = get_inner_dtable_server_url()

        import dtable_events

        try:
            base = DTableServerAPI(username, dtable_uuid, dtable_server_url)
            metadata = base.get_metadata()
            linked_table_name = get_linked_table_name(metadata, current_table_id, link_column_key)
            if not linked_table_name:
                return api_error(status.HTTP_404_NOT_FOUND, 'linked table not found')
            link_table_columns = base.list_columns(linked_table_name)


            sql = dtable_events.filter2sql(
                linked_table_name,
                link_table_columns,
                filter_conditions,
                by_group=False
            )

            dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            rows = dtable_db_api.query(sql)['results']

            return Response({"linked_table_rows": rows})

        except dtable_events.SQLGeneratorOptionInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, app_page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        except dtable_events.DateTimeQueryInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, app_page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        except Exception as e:
            logger.exception('query dtable-db dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')



class DTableUniversalAppsSearchLinkedTableRowsView(APIView):
