        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        app_user_obj = check_app_user(universal_app, username)
        if not app_user_obj:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        app_user_obj = check_app_user(universal_app, app_user)
        if not app_user_obj:
            error_msg = 'User %s has left the app and cannot participate in comments.' % app_user
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if DTableAppRowParticipants.objects.filter(
            app_user = app_user_obj,
            dtable_uuid = dtable_uuid,
            app = universal_app,
            table_id = table_id,
            row_id = row_id
        ).exists():
            error_msg = 'app user %s already exists.' % app_user
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)


        # dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)


        app_pages = app_config.get('settings', {}).get('pages', [])
        app_table_ids = [page.get('table_id') for page in app_pages]
        if table_id not in app_table_ids:
            error_msg = 'table_id %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        error = _resource_check(username, dtable_uuid, table_id, row_id)
        if error:
            return error

        # main logic

        # add a participants
        try:
            new_participant, _ = DTableAppRowParticipants.objects.add_participant(
                universal_app, dtable_uuid, app_user, table_id, row_id
            )
        except Exception as e:
            logger.error(e)
            error_msg = "Internal Server Error"
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)


        return Response({'row_participant': new_participant.to_dict()})

class DTableUniversalAppRowParticipantView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def delete(self, request, app_uuid, participant_id):

        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username')
        app_user_obj = check_app_user(universal_app, username)
        if not app_user_obj:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # main logic

        # 1. delete a participants
        try:
            participant = DTableAppRowParticipants.objects.filter(pk=participant_id, app=universal_app).first()
            if participant:
                participant.delete()
        except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)


        return Response({'success': True})


class DTableUniversalAppFoldersView(APIView):
    authentication_classes = (TokenAuthentication, SessionAuthentication)
    permission_classes = (IsAuthenticated,)
    throttle_classes = (UserRateThrottle,)

    def post(self, request):
        # add an app folder
        name = request.data.get('name')
        folder_type = request.data.get('folder_type')
        if not name:
            return api_error(status.HTTP_400_BAD_REQUEST, 'name invalid.')

        if not folder_type or folder_type not in APP_FOLDER_TYPES:
            return api_error(status.HTTP_400_BAD_REQUEST, 'folder type invalid.')

        username = request.user.username

        name = DtableAppFolders.objects.get_non_duplicated_name(name, username, folder_type)
        try:
            folder = DtableAppFolders.objects.create(name=name, username=username, folder_type=folder_type)
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'folder': folder.to_dict()})

def get_apps_in_app_folder(username, folder):
    folder_apps_ids = DtableAppFolderItems.objects.filter(folder_id=folder.pk).values_list("app_id", flat=True)

    folder_app_users = DTableAppUsers.objects.filter(username=username, app_id__in=folder_apps_ids, app__inactive=False)

    apps_in_app_folder = []

    vaild_app_ids = []

    user_apps = [user.app for user in folder_app_users]
    dtable_uuids = [app.dtable_uuid for app in user_apps ]
    dtables = DTables.objects.filter(uuid__in=dtable_uuids, deleted=0)
    uuid_dtable_obj_map = {d.uuid.hex: d for d in dtables}

    try:
        for user in folder_app_users:
            role = user.role
            role_name = role.role_name
            if role_name == 'admin' and folder.folder_type != MY_MANAGED_APP:
                continue
            elif role_name != 'admin' and folder.folder_type != CAN_USED_APP:
                continue
            app = user.app
            app_user_id = user.id
            if app.dtable_uuid not in uuid_dtable_obj_map:
                continue
            info_dict = {
                    'app_user_id': app_user_id,
                    'app_id': app.pk,
                    'app_name': app.app_name,
                    'app_uuid': app.app_uuid,
                    'app_config': app.app_config,
                    'role_name': role_name,
                    'permission': role.role_permission,
                    'dtable_uuid': app.dtable_uuid,
                    'dtable_name': uuid_dtable_obj_map[app.dtable_uuid].name,
                    'workspace_id': uuid_dtable_obj_map[app.dtable_uuid].workspace_id,
                    'link': app.link,
                    'edit_link': app.edit_link,
                    'joined_at': datetime_to_isoformat_timestr(user.created_at)
                }
            
            apps_in_app_folder.append(info_dict)
            vaild_app_ids.append(app.pk)

        #clean invalid app_id
        DtableAppFolderItems.objects.filter(folder_id=folder.pk, app_id__in=set(folder_apps_ids)-set(vaild_app_ids)).delete()

    except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

    return apps_in_app_folder


class DtableUniversalAppFolderView(APIView):
    authentication_classes = (TokenAuthentication, SessionAuthentication)
    permission_classes = (IsAuthenticated,)
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_folder_id):
        # list all apps in current folder

        try:
            app_folder_id = int(app_folder_id)
        except:
            error_msg = "app_folder_id invalid"
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        username = request.user.username

        folder_queryset = DtableAppFolders.objects.filter(pk=app_folder_id, username=username)
        if not folder_queryset.exists():
            error_msg = 'Folder %s does not exist.' % app_folder_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        app_folder = folder_queryset.first()
        app_list = []

        try:
            app_list = get_apps_in_app_folder(username, app_folder)
        except Exception as e:
            logger.exception(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')
        return Response({
            'app_list': app_list,
        })


    def put(self, request, app_folder_id):
        # rename an app folder
        try:
            app_folder_id = int(app_folder_id)
        except:
            error_msg = "app_folder_id invalid"
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        name = request.data.get('name')
        username = request.user.username

        try:
            app_folder = DtableAppFolders.objects.filter(pk=app_folder_id, username=username).first()
            if not app_folder:
                error_msg = 'Folder %s does not exist.' % app_folder_id
                return api_error(status.HTTP_404_NOT_FOUND, error_msg)
            name = DtableAppFolders.objects.get_non_duplicated_name(name, username, app_folder.folder_type)
            app_folder.name = name
            app_folder.save()
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'folder': app_folder.to_dict()})

    def delete(self, request, app_folder_id):
        # delete an app folder
        try:
            app_folder_id = int(app_folder_id)
        except:
            error_msg = "app_folder_id invalid"
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        username = request.user.username

        try:
            app_folder = DtableAppFolders.objects.filter(pk=app_folder_id, username=username).first()
            if not app_folder:
                error_msg = 'Folder %s does not exist.' % app_folder_id
                return api_error(status.HTTP_404_NOT_FOUND, error_msg)

            app_folder.delete()
            DtableAppFolderItems.objects.filter(folder_id=app_folder_id).delete()
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'success': True})

class MoveDtableUniversalAppToFolderView(APIView):
    authentication_classes = (TokenAuthentication, SessionAuthentication)
    permission_classes = (IsAuthenticated,)
    throttle_classes = (UserRateThrottle,)


    @staticmethod
    def check_app_and_folder_type(username, app_uuid, to_folder):
        """
        return: error -> api_error or None
        """
        app = DTableExternalApps.objects.filter(app_uuid=app_uuid)
        if not app:
            return api_error(status.HTTP_404_NOT_FOUND, 'App not found')
        else:
            app = app.first()
        user = DTableAppUsers.objects.filter(username=username, app_id=app.pk)
        if not user:
            return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
        else:
            user = user.first()
        is_admin = True if user.role.role_name == "admin" else False
        if is_admin:
            if to_folder.folder_type == MY_MANAGED_APP:
                return None
            else:
                return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')
        else:
            if to_folder.folder_type == CAN_USED_APP:
                return None
            else:
                return api_error(status.HTTP_403_FORBIDDEN, 'Permission denied')

    def post(self, request, app_uuid):

        username = request.user.username
        move_from = request.data.get('move_from')  # from folder_id or /
        move_to = request.data.get('move_to')  # to folder_id or /

        app = DTableExternalApps.objects.filter(app_uuid=app_uuid)
        if not app:
            error_msg = 'App not found'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        app_id = app.first().pk

        ## from and to check, resource and permission check
        if move_from != '/':
            move_from_folder = DtableAppFolders.objects.filter(id=move_from, username=username).first()
            if not move_from_folder:
                return api_error(status.HTTP_404_NOT_FOUND, 'From folder not found')
            if not DtableAppFolderItems.objects.filter(folder_id=move_from,  app_id=app_id).exists():
                return api_error(status.HTTP_404_NOT_FOUND, 'App not found in folder')

        if move_to != '/':
            move_to_folder = DtableAppFolders.objects.filter(id=move_to, username=username).first()
            if not move_to_folder:
                return api_error(status.HTTP_404_NOT_FOUND, 'To folder not found')
            error = self.check_app_and_folder_type(username, app_uuid, move_to_folder)
            if error:
                return error

        # move
        try:
            if move_from == '/':
                DtableAppFolderItems.objects.create(folder_id=move_to, app_id=app_id)
            elif move_to == '/':
                DtableAppFolderItems.objects.filter(folder_id=move_from, app_id=app_id).delete()
            else:
                DtableAppFolderItems.objects.filter(folder_id=move_from, app_id=app_id).update(
                    folder_id=move_to
                )
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'success': True})
    
class DTableUniversalAppsAssetZipTaskView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def post(self, request, app_uuid):
        """
        Parameter:
        {
            "files_map": {"file1": "filename1", "file2": "filename2"},
            "page_id": page_id,
            "table_id": table_id
        }
        """
        # jwt permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)
        
        # arguments check
        files_map = request.data.get('files_map', None)
        if not files_map or not isinstance(files_map, dict):
            return api_error(status.HTTP_400_BAD_REQUEST, 'files_map is invalid.')

        files = list(files_map.keys())
        if len(files) > 200:
            return api_error(status.HTTP_400_BAD_REQUEST, 'Download up to 200 files at a time')
        
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        
        table_id = request.data.get('table_id')
        if not table_id:
            error_msg = 'table_id invalid'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # resource and resourece's permission check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        
        username = payload.get('username')
        app_user_obj = check_app_user(universal_app, username)
        if not app_user_obj:
            error_msg = 'Permission denied'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.' % app_uuid
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)
        
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        if page.get('table_id') != table_id:
            return api_error(status.HTTP_400_BAD_REQUEST, 'Table invalid')

        dtable_uuid = universal_app.dtable_uuid
        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid, include_deleted=False)
        if not dtable:
            return api_error(status.HTTP_404_NOT_FOUND, 'Base not found')
        
        repo_id = dtable.workspace.repo_id
        if not seafile_api.get_repo(repo_id):
            return api_error(status.HTTP_404_NOT_FOUND, 'Library not found')
        
        asset_dir = os.path.join('/asset', str(dtable.uuid))
        if not seafile_api.get_dirent_by_path(repo_id, asset_dir):
            return api_error(status.HTTP_404_NOT_FOUND, 'Files not found')

        error, table = get_table_by_id(dtable_uuid, table_id)
        if error:
            return error
        
        if not table:
            return api_error(status.HTTP_404_NOT_FOUND, 'table not found')
        
        params = {
            'username': username,
            'repo_id': repo_id,
            "dtable_uuid": str(dtable.uuid),
            'files': files,
            'files_map': json.dumps(files_map),
        }

        try:
            task_id = export_dtable_asset_files(params=params)
        except Exception as e:
            logger.error(e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        return Response({'task_id': task_id})

    re_path(r'^api/v2.1/universal-apps/(?P<app_uuid>[-0-9a-f]{36})/convert-table-to-excel/$', DTableUniversalAppConvertTablePageToExcelView.as_view(), name='api-v2.1-dtable-universal-app-convert-table-page-to-excel'),
    re_path(r'^api/v2.1/universal-apps/(?P<app_uuid>[-0-9a-f]{36})/export-table-to-excel/$', DTableUniversalAppTablePageExportExcel.as_view(), name='api-v2.1-dtable-universal-app-export-table-to-excel'),

class DTableUniversalAppConvertTablePageToExcelView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        """ list page rows
        """
        page_id = request.GET.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        start = request.GET.get('start', 0)
        limit = request.GET.get('limit', 100)
        try:
            start = int(start)
            limit = int(limit)
        except ValueError:
            start = 0
            limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        table_id = page.get('table_id')

        if page['type'] != 'table':
            # 非table类型的不能导出
            pass




        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')
        columns = table.get('columns')
        table_column_keys = [col.get('key') for col in columns]

        shown_column_keys = page.get('shown_column_keys', [])
        shown_title_column_key = page.get('shown_title_column_key')
        shown_image_column_key = page.get('shown_image_column_key')
        if shown_title_column_key and shown_title_column_key not in shown_column_keys:
            shown_column_keys.append(shown_title_column_key)
        if shown_image_column_key and shown_image_column_key not in shown_column_keys:
            shown_column_keys.append(shown_image_column_key)

        if page['type'] == 'single_record_page':
            shown_column_keys = [key for key in table_column_keys]

        if not shown_column_keys:
            error_msg = 'shown_column_keys is empty.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        # metadata 还是在dtable-web 中获取比较合适， 也可以不用，因为 shown_column_keys 与metadata无关，
        # 或者把shown_column_keys 全部传过去， _id, _archived, _locked不需要传

        shown_column_names = ['`' + column.get('name', '') + '`'
            for column in columns if column.get('key') in shown_column_keys]
        shown_column_names.append('`_id`')
        shown_column_names.append('`_archived`')
        shown_column_names.append('`_locked`')
        #
        # if page['type'] == 'single_record_page':
        #     filters = page.get('pre_filters', [])
        #     filter_conjunction = page.get('pre_filter_conjunction', 'And')
        #     sorts = page.get('pre_sorts', [])
        # else:
        #     filters = page.get('filters', [])
        #     filter_conjunction = page.get('filter_conjunction', 'And')
        #     sorts = page.get('sorts', [])

        filters = page.get('filters', [])
        filter_conjunction = page.get('filter_conjunction', 'And')
        sorts = page.get('sorts', [])

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''
        user_department_ids_map = get_departments_map_by_username(username)
        current_user_department_ids = user_department_ids_map['current_user_department_ids']
        current_user_department_and_sub_ids = user_department_ids_map['current_user_department_and_sub_ids']
        filter_conditions = {
            'start': start,
            'limit': limit,
        }
        if sorts:
            filter_conditions['sorts'] = sorts

        if filters:
            # for item in filters:
            #     column_key = item.get('column_key')
            #     filter_term = item.get('filter_term')
            #     filter_predicate = item.get('filter_predicate')
            #     if column_key not in table_column_keys:
            #         error_msg = 'some columns in the pre-filter has been deleted.'
            #         return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
            #     if filter_predicate == 'include_me':
            #         item['filter_term'].append(username)
            #     if filter_predicate == 'is_current_user_ID':
            #         item['filter_term'] = id_in_org
            #     if filter_term == 'current_user_department':
            #         item['filter_term'] = current_user_department_ids
            #     if filter_term == 'current_user_department_and_sub':
            #         item['filter_term'] = current_user_department_and_sub_ids
            #     if isinstance(filter_term, list):
            #         if 'current_user_department' in filter_term or 'current_user_department_and_sub' in filter_term:
            #             for i in range(len(filter_term)):
            #                 if filter_term[i] == 'current_user_department':
            #                     filter_term[i] = current_user_department_ids
            #                 elif filter_term[i] == 'current_user_department_and_sub':
            #                     filter_term[i] = current_user_department_and_sub_ids
            #             flat_result = [item for sublist in filter_term for item in (sublist if isinstance(sublist, list) else [sublist])]
            #             item['filter_term'] = list(set(flat_result))
            filter_conditions['filters'] = filters
            filter_conditions['filter_conjunction'] = filter_conjunction

        # import dtable_events
        #
        # try:
        #     sql = dtable_events.filter2sql(
        #         table_name, columns, filter_conditions, by_group=False)
        #     sql = sql.replace('*', ', '.join(shown_column_names), 1)
        # except dtable_events.SQLGeneratorOptionInvalidError as e:
        #     logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
        #     return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        # except dtable_events.DateTimeQueryInvalidError as e:
        #     logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
        #     return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        # except Exception as e:
        #     logger.exception('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
        #     return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        #
        # dtable_db_api = DTableDBAPI('dtable-web', dtable_uuid, INNER_DTABLE_DB_URL)
        # try:
        #     resp_json = dtable_db_api.query(sql)
        # except requests.Timeout as e:
        #     logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
        #     error_msg = 'Internal Server Error'
        #     return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        # except Exception as e:
        #     logger.exception('query dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
        #     return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        # return Response(resp_json, status=status.HTTP_200_OK)


        from seahub.dtable.utils import add_convert_app_table_page_to_excel_task

        is_support_image = request.GET.get('is_support_image', 'false')
        if is_support_image not in ('true', 'false'):
            error_msg = 'is_support_image invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        params = {
            'app_name': app_config.get('name'),  # app_name 和page_name 为了确定Excel的名称
            'page_name': page.get('name'),
            'dtable_uuid': dtable_uuid,
            'table_id': table_id,
            'username': username,
            'is_support_image': is_support_image,
            # 'table_name': table_name,
            'filter_conditions': filter_conditions,

            'shown_column_keys': shown_column_keys,
        }

        # dtable_uuid, table_id, username, app_name, page_name, filter_conditions, shown_column_keys, is_support_image


        # app_name = app_name
        #     page_name = page_name
        #     dtable_uuid = dtable_uuid
        #     table_id = table_id
        #     username = username
        #     # table_name = 'table_name'
        #     filter_conditions = {}
        #     shown_column_keys = []

        try:
            task_id = add_convert_app_table_page_to_excel_task(params)
        except Exception as e:
            logger.error('convert big data view to excel task error: %s', e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error.')

        return Response({'task_id': task_id})


class DTableUniversalAppTablePageExportExcel(APIView):
    authentication_classes = (TokenAuthentication, SessionAuthentication)
    permission_classes = (IsAuthenticated,)
    throttle_classes = (UserRateThrottle,)

    # def get(self, request, workspace_id, name):
    def get(self, request, app_uuid):

        task_id = request.GET.get('task_id', '')
        if not task_id:
            error_msg = 'task_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        page_id = request.GET.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # start = request.GET.get('start', 0)
        # limit = request.GET.get('limit', 100)
        # try:
        #     start = int(start)
        #     limit = int(limit)
        # except ValueError:
        #     start = 0
        #     limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # table_name = request.GET.get('table_name', '')
        # if not table_name:
        #     error_msg = 'table_name invalid.'
        #     return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        #
        # view_name = request.GET.get('view_name', '')
        # if not view_name:
        #     error_msg = 'view_name invalid.'
        #     return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        #
        # table_id = request.GET.get('table_id', '')
        # if not table_id:
        #     error_msg = 'table_id invalid.'
        #     return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        #
        # view_id = request.GET.get('view_id', '')
        # if not view_id:
        #     error_msg = 'view_id invalid.'
        #     return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
        #
        # # resource check
        # workspace = Workspaces.objects.get_workspace_by_id(workspace_id)
        # if not workspace:
        #     error_msg = 'Workspace %s not found.' % workspace_id
        #     return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        #
        # dtable = DTables.objects.get_dtable(workspace, name)
        # if not dtable:
        #     error_msg = 'Base %s not found.' % name
        #     return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # # permission check
        # permission = check_dtable_permission(request.user.username, workspace, dtable) \
        #              or get_view_share_permission_by_view(request.user.username, dtable, table_id, view_id)
        # if not permission:
        #     error_msg = 'Permission denied.'
        #     return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        from seahub.api2.endpoints.dtable_excel import TEMP_EXPORT_VIEW_DIR
        from django.http import FileResponse
        from urllib.parse import quote
        target_dir = TEMP_EXPORT_VIEW_DIR + dtable_uuid

        app_name = app_config.get('name')  # app_name 和page_name 为了确定Excel的名称
        page_name = page.get('name')

        # sheet_name = escape_sheet_name(page_name)
        # name 这个name是base的name， 这里可以改成app的name + page_name

        excel_name = app_name + '_' + page_name + '.xlsx'
        # target_path = os.path.join(target_dir, excel_name)

        # excel_name = name + '_' + table_name + ('_' + view_name if view_name else '') + '.xlsx'
        # target_dir = TEMP_EXPORT_VIEW_DIR + str(dtable.uuid)
        tmp_excel_path = os.path.join(target_dir, excel_name)
        if not os.path.isfile(tmp_excel_path):
            return api_error(status.HTTP_404_NOT_FOUND, excel_name + ' not found.')

        # tmp-excel-file is in container, for download multiple times do not delete it
        response = FileResponse(open(tmp_excel_path, 'rb'), content_type='application/ms-excel', as_attachment=True)
        response['Content-Disposition'] = 'attachment;filename*=UTF-8\'\'' + quote(excel_name)
        return response
