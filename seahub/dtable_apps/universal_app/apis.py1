def get_metadata(dtable_uuid):
    """ return (error, metadata)
    """
    dtable_server_api = DTableServerAPI('dtable-web', str(dtable_uuid), get_inner_dtable_server_url())
    try:
        metadata = dtable_server_api.get_metadata()
    except Exception as e:
        logger.exception('request dtable: %s metadata error: %s', dtable_uuid, e)
        return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error'), None

    return None, metadata


def get_table_by_id(dtable_uuid, table_id):
    """ return (error, metadata)
    """
    metadata = get_metadata(dtable_uuid)[1]
    table = next(filter(lambda table: table['_id'] == table_id, metadata['tables']), None)
    return None, table


def _parse_row_data(dtable, metadata, table_name, row_data_dict):
    """ return (error, row_data_dict)
    """
    # columns
    table = next(filter(lambda x: x['name'] == table_name, metadata['tables']), None)
    if not table:
        return api_error(status.HTTP_404_NOT_FOUND, 'table %s not found.' % (table_name)), None
    columns = table['columns']

    # migrate image files from assets/xxx/public/universal-app/xxx to assets/xxx/images/xxx
    image_col_names = [col['name'] for col in columns if col['type'] == 'image']
    long_text_col_names = [col['name'] for col in columns if col['type'] == 'long-text']

    for name in image_col_names:
        image_links = row_data_dict.get(name)
        if not image_links:
            continue
        new_links = []
        for link in image_links:
            try:
                new_link = migrate_image(link, dtable, UNIVERSAL_APPS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, username='universal-app')
            except Exception as e:
                logger.error('migrate image: %s from: %s to: %s error: %s', link, UNIVERSAL_APPS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, e)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            if not new_link:
                new_link = link
            new_links.append(new_link)
        row_data_dict[name] = new_links

    row_data_keys = row_data_dict.keys()
    for name in long_text_col_names:
        if name not in row_data_keys:
            continue
        long_text_value = row_data_dict.get(name, {})
        if not long_text_value:
            continue
        long_text_images = long_text_value.get('images', [])
        if (len(long_text_images) == 0):
            row_data_dict[name] = long_text_value.get('text', '')
        else:
            long_text_text = long_text_value.get('text', '')
            for long_text_image in long_text_images:
                try:
                    new_link = migrate_image(long_text_image, dtable, UNIVERSAL_APPS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, username='universal-app')
                except Exception as e:
                    logger.error('migrate image: %s from: %s to: %s error: %s', long_text_image, UNIVERSAL_APPS_RELATIVE_PATH, UPLOAD_IMG_RELATIVE_PATH, e)
                    return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
                if not new_link:
                    new_link = long_text_image
                long_text_text = long_text_text.replace(long_text_image.strip(), new_link)
            row_data_dict[name] = long_text_text

    return None, row_data_dict


def _can_modify_link_column(page):
    if not page:
        return False
    
    page_type = page.get('type', '')
    return page_type == 'table' or page_type == 'kanban' or page_type == 'gallery' 


class DTableUniversalAppsMetadataView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        """ get metadata
        """
        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()

        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error

        return Response(metadata)


def submit_and_update_links(dtable_server_api: DTableServerAPI, table, tables, row_id, link_rows, new_linked_rows, apply_default=False):
    # 1. handle links
    link_info_dict = {}  # {"<link_id>": {"table_id": xxx, "other_table_id": xxx, "row_id": x}}
    # 1.1 handle link rows already exists

    if link_rows:
        for link in link_rows:
            link_id = link.get('link_id')
            other_table_name = link.get('other_table_name')
            other_row_ids = link.get('row_ids')
            other_table = next(filter(lambda x: x.get('name') == other_table_name, tables), None)
            if not other_table:
                continue

            link_info_dict[link_id] = {
                "table_id": table['_id'],
                "other_table_id": other_table['_id'],
                "other_table_name": other_table_name,
                "row_id": row_id,
                "other_row_ids": other_row_ids
            }

    # 2.2 handle links with new row

    if new_linked_rows:
        for link in new_linked_rows:
            link_id = link.get('link_id')
            other_table_name = link.get('other_table_name')
            other_row_datas = link.get('row_datas')

            # add row
            new_row_ids = []
            for row_data in other_row_datas:
                new_row = dtable_server_api.append_row(other_table_name, row_data, apply_default=apply_default)
                new_row_ids.append(new_row['_id'])

            other_table = next(filter(lambda x: x.get('name') == other_table_name, tables), None)
            if not other_table:
                continue
            link_info = link_info_dict.get(link_id)
            if link_info:
                other_row_ids = link_info.get("other_row_ids") or []
                other_row_ids.extend(new_row_ids)
                link_info_dict[link_id]["other_row_ids"] = other_row_ids
                link_info_dict[link_id]["other_table_name"] = other_table_name
            else:
                link_info_dict[link_id] = {
                    "table_id": table['_id'],
                    "other_table_id": other_table['_id'],
                    "other_table_name": other_table_name,
                    "row_id": row_id,
                    "other_row_ids": new_row_ids
                }

    for link_id, link_info in link_info_dict.items():
        dtable_server_api.update_link(
            link_id=link_id,
            table_id=link_info['table_id'],
            other_table_id=link_info['other_table_id'],
            row_id=link_info['row_id'],
            other_rows_ids=link_info['other_row_ids']
        )

    return link_info_dict

def _get_option_id_by_name(column, option_name):
        options = column.get('data', {}).get('options', [])
        for op in options:
            if op.get('name') == option_name:
                return op.get('id')


def _check_row_data_exists(request_row_data, table, unique_column_keys, dtable_db_api):
    table_columns = table.get('columns', [])
    table_name = table.get('name')
    column_name_key_map = {col.get('name'): col.get('key') for col in table_columns}
    column_key_col_map = {col.get('key'): col for col in table_columns}
    request_row_data_revert = {}
    for col_name, value in request_row_data.items():
        col_key = column_name_key_map.get(col_name)
        request_row_data_revert[col_key] = value

    row_data_col_keys = request_row_data_revert.keys()
    if len(row_data_col_keys) < len(unique_column_keys):
        return False

    row_data_col_key_set = set(row_data_col_keys)
    unique_column_key_set = set(unique_column_keys)

    if row_data_col_key_set.intersection(unique_column_key_set) != unique_column_key_set:
        # the row data requested should totally contain the unique column
        return False

    filters = []
    for col_key in unique_column_keys:
        col = column_key_col_map[col_key]
        value = request_row_data_revert[col_key]

        if (value is None) or (value == ''):
            raise ValueEmptyError(name=col.get('name'))

        col_type = col.get('type')
        if col_type == 'single-select':
            value = _get_option_id_by_name(col, value)
            if not value:
                continue

        if col_type == 'multiple-select':
            value_list = []
            for v in value:
                option_id = _get_option_id_by_name(col, v)
                if option_id:
                    value_list.append(option_id)
            value = value_list

            if not value:
                continue
        filter_predicate = COLUMN_TYPE_MATCH_PREDICATE.get(col['type'])
        if not filter_predicate:
            continue
        filter_item = {
            "column_key": col_key,
            "filter_predicate": filter_predicate,
            "filter_term": value,
            "filter_term_modifier": "exact_date"
        }
        filters.append(filter_item)

    if not filters:
        return False

    filter_conditions = {
        'filters': filters,
        'filter_conjunction': 'And',
    }

    try:

        import dtable_events
        sql = dtable_events.filter2sql(table_name, table_columns, filter_conditions, by_group=False)
        res = dtable_db_api.query(sql)

        results = res.get('results')
        if results:
            return True

    except Exception as err:
        logger.exception('check duplicate row error', err)

class DTableUniversalAppsRowsView(APIView):
    authentication_classes = ()
    throttle_classes = (UserRateThrottle,)

    def get(self, request, app_uuid):
        """ list page rows
        """
        page_id = request.GET.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        start = request.GET.get('start', 0)
        limit = request.GET.get('limit', 100)
        try:
            start = int(start)
            limit = int(limit)
        except ValueError:
            start = 0
            limit = 100

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_read(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        table_id = page.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')
        columns = table.get('columns')
        table_column_keys = [col.get('key') for col in columns]
        shown_column_keys = page.get('shown_column_keys', [])
        shown_title_column_key = page.get('shown_title_column_key')
        shown_image_column_key = page.get('shown_image_column_key')
        if shown_title_column_key and shown_title_column_key not in shown_column_keys:
            shown_column_keys.append(shown_title_column_key)
        if shown_image_column_key and shown_image_column_key not in shown_column_keys:
            shown_column_keys.append(shown_image_column_key)

        if page['type'] == 'single_record_page':
            shown_column_keys = [key for key in table_column_keys]

        if not shown_column_keys:
            error_msg = 'shown_column_keys is empty.'
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        shown_column_names = ['`' + column.get('name', '') + '`'
            for column in columns if column.get('key') in shown_column_keys]
        shown_column_names.append('`_id`')
        shown_column_names.append('`_archived`')
        shown_column_names.append('`_locked`')

        if page['type'] == 'single_record_page':
            filters = page.get('pre_filters', [])
            filter_conjunction = page.get('pre_filter_conjunction', 'And')
            sorts = page.get('pre_sorts', [])
        else:
            filters = page.get('filters', [])
            filter_conjunction = page.get('filter_conjunction', 'And')
            sorts = page.get('sorts', [])

        id_in_org_tuple = IdInOrgTuple.objects.filter(virtual_id=username)
        id_in_org = id_in_org_tuple[0].id_in_org if id_in_org_tuple else ''
        user_department_ids_map = get_departments_map_by_username(username)
        current_user_department_ids = user_department_ids_map['current_user_department_ids']
        current_user_department_and_sub_ids = user_department_ids_map['current_user_department_and_sub_ids']
        filter_conditions = {
            'start': start,
            'limit': limit,
        }
        if sorts:
            filter_conditions['sorts'] = sorts

        if filters:
            for item in filters:
                column_key = item.get('column_key')
                filter_term = item.get('filter_term')
                filter_predicate = item.get('filter_predicate')
                if column_key not in table_column_keys:
                    error_msg = 'some columns in the pre-filter has been deleted.'
                    return api_error(status.HTTP_400_BAD_REQUEST, error_msg)
                if filter_predicate == 'include_me':
                    item['filter_term'].append(username)
                if filter_predicate == 'is_current_user_ID':
                    item['filter_term'] = id_in_org
                if filter_term == 'current_user_department':
                    item['filter_term'] = current_user_department_ids
                if filter_term == 'current_user_department_and_sub':
                    item['filter_term'] = current_user_department_and_sub_ids
                if isinstance(filter_term, list):
                    if 'current_user_department' in filter_term or 'current_user_department_and_sub' in filter_term:
                        for i in range(len(filter_term)):
                            if filter_term[i] == 'current_user_department':
                                filter_term[i] = current_user_department_ids
                            elif filter_term[i] == 'current_user_department_and_sub':
                                filter_term[i] = current_user_department_and_sub_ids
                        flat_result = [item for sublist in filter_term for item in (sublist if isinstance(sublist, list) else [sublist])]
                        item['filter_term'] = list(set(flat_result))
            filter_conditions['filters'] = filters
            filter_conditions['filter_conjunction'] = filter_conjunction

        import dtable_events

        try:
            sql = dtable_events.filter2sql(
                table_name, columns, filter_conditions, by_group=False)
            sql = sql.replace('*', ', '.join(shown_column_names), 1)
        except dtable_events.SQLGeneratorOptionInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid option in single or multiple select columns')
        except dtable_events.DateTimeQueryInvalidError as e:
            logger.warning('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_400_BAD_REQUEST, 'Invalid query in column %s' % e.column_name)
        except Exception as e:
            logger.exception('app: %s page: %s filter2sql error: %s', app_uuid, page_id, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        dtable_db_api = DTableDBAPI('dtable-web', dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            resp_json = dtable_db_api.query(sql)
        except requests.Timeout as e:
            logger.error('query dtable-db dtable: %s sql: %s timeout error: %s', dtable_uuid, sql, e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)
        except Exception as e:
            logger.exception('query dtable: %s sql: %s error: %s', dtable_uuid, sql, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response(resp_json, status=status.HTTP_200_OK)

    def post(self, request, app_uuid):
        """ insert row
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_data = request.data.get('row_data', None)
        if not row_data:
            row_data = {}

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if not app_page_can_add(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        table_id = request.data.get('table_id', None)
        if not table_id:
            table_id = page.get('table_id')

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')

        page_duplicate_record_setting = page.get('add_duplicate_record_setting') or {}
        duplicate_prohibition = page_duplicate_record_setting.get('duplicate_prohibition')
        if duplicate_prohibition:
            unique_column_keys = page_duplicate_record_setting.get('unique_column_keys', [])
            dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            try:
                res = _check_row_data_exists(row_data, table, unique_column_keys, dtable_db_api)
            except ValueEmptyError as e:
                error_msg = "Column %s cannot be empty" % e.name
                return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

            if res:
                error_msg = 'Cannot_add_same_records'
                return api_error(status.HTTP_409_CONFLICT, error_msg)


        # migrate image files
        error, row_data_dict = _parse_row_data(dtable, metadata, table_name, row_data)
        if error:
            return error

        dtable_server_url = get_inner_dtable_server_url()
        dtable_server_api = DTableServerAPI(username, str(dtable.uuid), dtable_server_url)
        try:
            resp_json = dtable_server_api.append_row(table_name, row_data_dict, apply_default=True)
            row_data_dict.update(resp_json)
        except requests.Timeout as e:
            logger.error('dtable: %s append row data: %s timeout error: %s', dtable_uuid, row_data_dict, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('POST dtable: %s row data: %s error: %s', dtable_uuid, row_data_dict, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        link_rows = request.data.get('link_rows', [])
        new_linked_rows = request.data.get('new_linked_rows', [])

        try:
            link_info_dict = submit_and_update_links(dtable_server_api, table, tables, row_data_dict['_id'], link_rows, new_linked_rows)
        except Exception as e:
            logger.error(e)
            error_msg = 'Internal Server Error'
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, error_msg)

        return Response({ 'row_data': row_data_dict, 'link_info': link_info_dict }, status=status.HTTP_201_CREATED)

    def put(self, request, app_uuid):
        """ update row
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'page_id invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        rows_data = request.data.get('rows_data')
        if not rows_data:
            error_msg = 'row_data invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        try:
            is_copy_paste = to_python_boolean(request.data.get('is_copy_paste', 'false'))
        except:
            is_copy_paste = False

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        dtable = DTables.objects.get_dtable_by_uuid(dtable_uuid)
        if not dtable:
            error_msg = 'dtable %s not found.' % dtable_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''
        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_id = page.get('table_id')

        if not app_page_can_modify(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')

        # migrate image files
        updates = []
        if is_copy_paste:
            updates = rows_data
        else:
            for row_data in rows_data:
                row_id = row_data.get('row_id')
                data = row_data.get('row')
                error, row_data_dict = _parse_row_data(dtable, metadata, table_name, data)
                if error:
                    return error
                updates.append({
                    'row_id': row_id,
                    'row': row_data_dict
                })

        if updates:
            data = {
                'table_name': table_name,
                'updates': updates,
            }
            dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
            try:
                dtable_db_api.batch_update_rows(table_name, updates)
            except requests.Timeout as e:
                logger.error('dtable: %s PUT row updates: %s timeout error: %s', dtable_uuid, updates, e)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
            except Exception as e:
                logger.exception('dtable: %s PUT row updates: %s error: %s', dtable_uuid, updates, e)
                return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'Success': True}, status=status.HTTP_200_OK)

    def delete(self, request, app_uuid):
        """ delete row
        """
        # argument check
        page_id = request.data.get('page_id')
        if not page_id:
            error_msg = 'table_name invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        row_ids = request.data.get('row_ids', [])
        if not row_ids:
            error_msg = 'row_ids invalid.'
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        # resource check
        universal_app = DTableExternalApps.objects.filter(app_uuid=app_uuid).first()
        if not universal_app:
            error_msg = 'app %s not found.' % app_uuid
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)

        if universal_app.inactive:
            error_msg = _('This app is not available')
            return api_error(status.HTTP_400_BAD_REQUEST, error_msg)

        dtable_uuid = uuid_str_to_36_chars(universal_app.dtable_uuid)
        app_config = json.loads(universal_app.app_config)
        app_type = app_config.get('app_type')
        if app_type != 'universal-app':
            error_msg = 'app_type invalid.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)


        # permission check
        auth = request.META.get('HTTP_AUTHORIZATION', '').split()
        is_valid, payload = is_valid_app_jwt(auth, app_uuid, return_payload=True)
        if len(auth) != 2 or not is_valid:
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        username = payload.get('username') or ''  # anonymous = ''

        # main
        app_config = json.loads(universal_app.app_config)
        pages = app_config.get('settings').get('pages')
        page = next(filter(lambda x: x.get('id') == page_id, pages), None)
        if not page:
            error_msg = 'page %s not found.' % page_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_id = page.get('table_id')

        if not app_page_can_delete(payload, page):
            error_msg = 'Permission denied.'
            return api_error(status.HTTP_403_FORBIDDEN, error_msg)

        # metadata
        error, metadata = get_metadata(dtable_uuid)
        if error:
            return error
        tables = metadata.get('tables')
        table = next(filter(lambda x: x.get('_id') == table_id, tables), None)
        if not table:
            error_msg = 'table %s not found.' % table_id
            return api_error(status.HTTP_404_NOT_FOUND, error_msg)
        table_name = table.get('name')

        dtable_db_api = DTableDBAPI(username, dtable_uuid, INNER_DTABLE_DB_URL)
        try:
            dtable_db_api.batch_delete_rows(table_name, row_ids)
        except requests.Timeout as e:
            logger.error('dtable: %s DELETE row_ids: %s timeout error: %s', dtable_uuid, row_ids, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')
        except Exception as e:
            logger.exception('dtable: %s DELETE row_ids: %s error: %s', dtable_uuid, row_ids, e)
            return api_error(status.HTTP_500_INTERNAL_SERVER_ERROR, 'Internal Server Error')

        return Response({'success': True}, status=status.HTTP_200_OK)

