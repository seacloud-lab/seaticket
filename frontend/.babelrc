{
  "presets": ["react-app"],
  "plugins": [
    ["import", {
      "libraryName": "dtable-ui-component",
      "libraryDirectory": "lib",
      "camel2DashComponentName": false,
      "camel2UnderlineComponentName": false
    },
      "dtable-ui-component"
    ],
    ["import", { "libraryName": "antd-mobile", "libraryDirectory": "lib"}, "antd-mobile"]
  ]
}
