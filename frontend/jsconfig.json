{
  "compilerOptions": {
      "paths": {
          "@/*": ["./src/*"],
          "@components/*": ["./src/components/*"],
          "@constants": ["./src/constants/index"],
          "@constants/*": ["./src/constants/*"],
          "@utils/*": ["./src/utils/*"]
      },
      "module": "ESNext",
      "moduleResolution": "bundler",
      "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
