{
  "name": "seaqa-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@gatsbyjs/reach-router": "2.0.1",
    "@seafile/seafile-calendar": "1.0.5",
    "@seafile/seafile-editor": "^2.0.47",
    "autoprefixer": "10.4.24",
    "axios": "~1.13.5",
    "classnames": "^2.3.2",
    "copy-to-clipboard": "3.3.1",
    "dayjs": "1.10.7",
    "deep-copy": "^1.4.2",
    "embedding-atlas": "^0.15.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "is-hotkey": "0.2.0",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "prop-types": "^15.6.2",
    "react": "18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.5.2",
    "react-responsive": "10.0.0",
    "react-select": "5.9.0",
    "reactstrap": "9.2.3",
    "recharts": "^3.7.0",
    "rmc-dialog": "1.1.1",
    "rmc-feedback": "2.0.0",
    "rmc-tabs": "1.2.29",
    "slugid": "^2.0.0",
    "unified": "7.0.0"
  },
  "scripts": {
    "lint": "export NODE_ENV=development && ./node_modules/.bin/eslint ./src/",
    "lint-fix": "export NODE_ENV=development && ./node_modules/.bin/eslint ./src/ --fix",
    "start": "node scripts/start.js",
    "build": "node -max_old_space_size=4096 scripts/build.js",
    "test": "node scripts/test.js",
    "dev": "node config/server.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jest-environment-jsdom-fourteen",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/runtime": "7.28.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.3",
    "@svgr/webpack": "8.1.0",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "11.1.0",
    "@testing-library/user-event": "13.5.0",
    "babel-eslint": "10.0.3",
    "babel-jest": "^27.4.2",
    "babel-loader": "^8.2.3",
    "babel-plugin-import": "^1.13.6",
    "babel-plugin-named-asset-import": "^0.3.8",
    "babel-preset-react-app": "^10.0.1",
    "browserslist": "^4.18.1",
    "camelcase": "^6.2.1",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "css-loader": "^6.5.1",
    "css-minimizer-webpack-plugin": "^3.2.0",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "eslint": "^8.3.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-webpack-plugin": "^3.1.1",
    "file-loader": "^6.2.0",
    "fs-extra": "^10.0.0",
    "html-webpack-plugin": "^5.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.4.3",
    "jest-resolve": "^27.4.2",
    "jest-watch-typeahead": "^1.0.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "mini-css-extract-plugin": "^2.4.5",
    "node-polyfill-webpack-plugin": "2.0.1",
    "postcss": "^8.4.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^6.2.1",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^7.0.1",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-refresh": "^0.11.0",
    "resolve": "^1.20.0",
    "resolve-url-loader": "^5.0.0",
    "sass-loader": "^12.3.0",
    "semver": "^7.3.5",
    "source-map-loader": "^3.0.0",
    "style-loader": "^3.3.1",
    "svgo-loader": "^3.0.1",
    "terser-webpack-plugin": "^5.2.5",
    "web-vitals": "2.1.4",
    "webpack": "^5.105.0",
    "webpack-bundle-tracker": "1.7.0",
    "webpack-dev-server": "^5.2.3",
    "webpack-manifest-plugin": "^4.0.2",
    "workbox-webpack-plugin": "^6.4.1",
    "worker-loader": "^3.0.8"
  }
}
